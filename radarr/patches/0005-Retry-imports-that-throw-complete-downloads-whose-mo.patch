@@ -30,13 +30,17 @@ public bool IsImported(TrackedDownload trackedDownload, List<MovieHistory> histo
                 return false;
             }
 
-            var movie = trackedDownload.RemoteMovie.Movie;
+            var movie = trackedDownload.RemoteMovie?.Movie;
 
-            var lastHistoryItem = historyItems.FirstOrDefault(h => h.MovieId == movie.Id);
+            // The cached tracked download loses its movie when it is rebuilt from a title that doesn't map to a movie (a
+            // download whose movie came from grab history), use the most recent history for the download in that case.
+            var lastHistoryItem = movie == null
+                ? historyItems.FirstOrDefault()
+                : historyItems.FirstOrDefault(h => h.MovieId == movie.Id);
 
             if (lastHistoryItem == null)
             {
-                _logger.Trace("No history for movie: {0}", movie.ToString());
+                _logger.Trace("No history for movie: {0}", movie?.ToString());
                 return false;
             }
 
