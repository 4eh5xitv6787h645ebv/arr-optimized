diff --git a/src/Radarr.Api.V3/Config/OptimizeConfigController.cs b/src/Radarr.Api.V3/Config/OptimizeConfigController.cs
new file mode 100644
index 000000000..72cccf2fe
--- /dev/null
+++ b/src/Radarr.Api.V3/Config/OptimizeConfigController.cs
@@ -0,0 +1,64 @@
+using System.Collections.Generic;
+using Microsoft.AspNetCore.Http.HttpResults;
+using Microsoft.AspNetCore.Mvc;
+using NzbDrone.Core.Optimize;
+using Radarr.Http;
+using Radarr.Http.REST;
+using Radarr.Http.REST.Attributes;
+
+namespace Radarr.Api.V3.Config
+{
+    // GET/PUT /api/v3/config/optimize: the Optimize settings page. PUT changes only the values present in the body (left
+    // out = unchanged, explicit null = reset to the default). Values set by an environment variable are reported as
+    // locked and are ignored on PUT (not an error, so the page can send its whole resource back).
+    // GET /api/v3/config/optimize/settings: every tunable value of the optimization patches with its effective value,
+    // default, source and how to change it. GET /api/v3/config/optimize/status: the built-in optimizations and counters.
+    [V3ApiController("config/optimize")]
+    public class OptimizeConfigController : RestController<OptimizeConfigResource>
+    {
+        private readonly IOptimizeSettingsService _optimizeSettingsService;
+
+        public OptimizeConfigController(IOptimizeSettingsService optimizeSettingsService)
+        {
+            _optimizeSettingsService = optimizeSettingsService;
+
+            SharedValidator.Include(new OptimizeConfigResourceValidator(optimizeSettingsService));
+        }
+
+        protected override OptimizeConfigResource GetResourceById(int id)
+        {
+            return GetOptimizeConfig();
+        }
+
+        [HttpGet]
+        [Produces("application/json")]
+        public OptimizeConfigResource GetOptimizeConfig()
+        {
+            return OptimizeConfigResourceMapper.ToResource(_optimizeSettingsService.Current, _optimizeSettingsService.GetSettings());
+        }
+
+        [RestPutById]
+        [Consumes("application/json")]
+        [Produces("application/json")]
+        public Results<Accepted<OptimizeConfigResource>, NotFound> SaveOptimizeConfig([FromBody] OptimizeConfigResource resource)
+        {
+            _optimizeSettingsService.Save(resource.ToValues());
+
+            return Accepted(resource.Id);
+        }
+
+        [HttpGet("settings")]
+        [Produces("application/json")]
+        public List<OptimizeSettingInfo> GetOptimizeSettings()
+        {
+            return _optimizeSettingsService.GetSettings();
+        }
+
+        [HttpGet("status")]
+        [Produces("application/json")]
+        public OptimizeStatus GetOptimizeStatus()
+        {
+            return _optimizeSettingsService.GetStatus();
+        }
+    }
+}
