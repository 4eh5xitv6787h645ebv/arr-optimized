index 000000000..45a43dec6
--- /dev/null
+++ b/src/NzbDrone.Core/Optimize/OptimizeSettingsService.cs
@@ -0,0 +1,421 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using NLog;
+using NzbDrone.Core.Configuration;
+using NzbDrone.Core.Configuration.Events;
+using NzbDrone.Core.CustomFormats;
+using NzbDrone.Core.Indexers;
+using NzbDrone.Core.Lifecycle;
+using NzbDrone.Core.MediaFiles.MediaInfo;
+using NzbDrone.Core.Messaging.Events;
+
+namespace NzbDrone.Core.Optimize
+{
+    public interface IOptimizeSettingsService
+    {
+        OptimizeSettings Current { get; }
+
+        // Reads the saved values again, publishes the new settings and applies changed cache limits.
+        OptimizeSettings Reload();
+
+        // Validation messages by tunable name for values that would be saved (locked and read-only tunables are skipped).
+        Dictionary<string, string> Validate(IDictionary<string, object> values);
+
+        // Saves values by tunable name and applies them at once. Locked (environment) and read-only tunables are
+        // ignored, as are tunables not in the dictionary (PUT: a property left out of the body is unchanged). Null, or
+        // the default value, clears the saved value (the source becomes "default"); through the API an explicit null
+        // resets a value, as in the Sonarr image.
+        OptimizeSettings Save(IDictionary<string, object> values);
+
+        List<OptimizeSettingInfo> GetSettings();
+        OptimizeStatus GetStatus();
+    }
+
+    public class OptimizeSettingsService : IOptimizeSettingsService, IHandle<ApplicationStartedEvent>, IHandle<ConfigSavedEvent>
+    {
+        private readonly IConfigService _configService;
+        private readonly IVideoFileInfoReader _videoFileInfoReader;
+        private readonly Logger _logger;
+        private readonly object _reloadLock = new object();
+
+        public OptimizeSettingsService(IConfigService configService, IVideoFileInfoReader videoFileInfoReader, Logger logger)
+        {
+            _configService = configService;
+            _videoFileInfoReader = videoFileInfoReader;
+            _logger = logger;
+        }
+
+        public OptimizeSettings Current => OptimizeSettings.Current;
+
+        public OptimizeSettings Reload()
+        {
+            lock (_reloadLock)
+            {
+                var previous = OptimizeSettings.Current;
+
+                // A copy of the saved values: later rebuilds (tests) never read the database under the settings lock.
+                var saved = OptimizeTunables.Editable.ToDictionary(t => t.ConfigKey, t => _configService.GetOptimizeValue(t.ConfigKey), StringComparer.OrdinalIgnoreCase);
+                var settings = OptimizeSettings.Load(key => saved.TryGetValue(key, out var value) ? value : null, _configService.CheckForFinishedDownloadInterval);
+
+                ApplyLimits();
+                LogChanges(previous, settings);
+
+                return settings;
+            }
+        }
+
+        public Dictionary<string, string> Validate(IDictionary<string, object> values)
+        {
+            var errors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+            var current = OptimizeSettings.Current;
+
+            foreach (var tunable in OptimizeTunables.Editable)
+            {
+                if (!TryGetValue(values, tunable, out var value) || value == null || current.IsLocked(tunable.Name))
+                {
+                    continue;
+                }
+
+                var error = tunable.TryParse(tunable.Format(value), false, out _);
+
+                if (error != null)
+                {
+                    errors[tunable.Name] = error;
+                }
+            }
+
+            return errors;
+        }
+
+        public OptimizeSettings Save(IDictionary<string, object> values)
+        {
+            lock (_reloadLock)
+            {
+                var errors = Validate(values);
+
+                if (errors.Any())
+                {
+                    throw new ArgumentException(string.Join("; ", errors.Values));
+                }
+
+                var current = OptimizeSettings.Current;
+
+                foreach (var tunable in OptimizeTunables.Editable)
+                {
+                    if (!TryGetValue(values, tunable, out var value) || current.IsLocked(tunable.Name))
+                    {
+                        continue;
+                    }
+
+                    string text = null;
+
+                    if (value != null)
+                    {
+                        tunable.TryParse(tunable.Format(value), false, out var parsed);
+
+                        // The default is not saved, so the value follows the default (and its source shows "default").
+                        if (!Equals(parsed, tunable.DefaultValue) && !(parsed is string s && s.Length == 0))
+                        {
+                            text = tunable.Format(parsed);
+                        }
+                    }
+
+                    if (_configService.GetOptimizeValue(tunable.ConfigKey) != text)
+                    {
+                        _configService.SetOptimizeValue(tunable.ConfigKey, text);
+                    }
+                }
+
+                return Reload();
+            }
+        }
+
+        public List<OptimizeSettingInfo> GetSettings()
+        {
+            var settings = OptimizeSettings.Current;
+
+            return OptimizeTunables.All.Select(t => ToInfo(t, settings)).ToList();
+        }
+
+        public OptimizeStatus GetStatus()
+        {
+            var settings = OptimizeSettings.Current;
+            var rateLimit = settings.RateLimit;
+            var reader = _videoFileInfoReader as VideoFileInfoReader;
+            var probeCache = reader?.ProbeCache;
+
+            var status = new OptimizeStatus
+            {
+                StartedUtc = OptimizeCounters.StartedUtc,
+                Features = new List<OptimizeFeature>
+                {
+                    Feature("Custom-format match cache", "Remembers which custom formats match a release; scores and decisions stay live.",
+                        settings.CustomFormatCacheCapacity > 0, $"On, up to {settings.CustomFormatCacheCapacity:N0} entries"),
+                    Feature("Per-search indexer memo", "Each indexer definition is read once per search or RSS sync.", settings.DecisionBatchMemo, "On"),
+                    Feature("Release profile cache", "Release profiles stay in memory until the next change.", settings.ReleaseProfileCache, "On"),
+                    Feature("Indexer settings type lookup", "The settings type of each provider row is looked up once per type.", true, "On"),
+                    Feature("Faster movie statistics", "Movie statistics match file totals with a lookup instead of a scan.", true, "On"),
+                    Feature("ffprobe result cache", "Media info of an unchanged file is reused instead of running ffprobe again.",
+                        settings.FfprobeCache.Enabled, $"On, up to {settings.FfprobeCache.Capacity:N0} files / {settings.FfprobeCache.MaxBytes / (1024 * 1024)} MB"),
+                    Feature("ffprobe timeout", "A hung ffprobe is stopped and the file gets no media info.", settings.FfprobeTimeout > TimeSpan.Zero,
+                        $"{settings.FfprobeTimeout.TotalMinutes:0} minutes"),
+                    Feature("Indexer request spacing", "Minimum time between requests to one indexer.", true,
+                        rateLimit.BaseRateLimit == IndexerRateLimitOptions.StockRateLimit ? "Stock, 2000 ms" : $"{rateLimit.BaseRateLimit.TotalMilliseconds:0} ms (stock 2000 ms)"),
+                    Feature("Cache hit refund", "A response served by a cache in front of the indexer gives its wait back.", rateLimit.RefundsCacheHits,
+                        rateLimit.RefundsCacheHits ? $"On, {rateLimit.CacheHitHeader}: {rateLimit.CacheHitValue}" : "Off"),
+                    Feature("Grab spacing", "Minimum time between grabs from one host.", true,
+                        rateLimit.GrabSpacing == IndexerRateLimitOptions.GrabRateLimit ? "Stock, 2000 ms" : $"{rateLimit.GrabSpacing.TotalMilliseconds:0} ms (stock 2000 ms)"),
+                    Feature("Import retry after an error", "A download whose import throws goes back to import pending instead of staying stuck.", true, "On"),
+                    Feature("Lost movie link recovery", "A finished download whose movie link was lost is completed from its import results or history.", true, "On"),
+                    Feature("Scheduler timer per instance", "In-app restarts no longer stack scheduler timers.", true, "On"),
+                    Feature("Duplicate extra files", "Replacing an -orig metadata file leaves no duplicate row; a daily cleanup removes old duplicates.", true, "On"),
+                    Feature("Exclusive housekeeping", "Housekeeping and its VACUUM start only when no other command runs.", true, "On"),
+                    Feature("Safe database restore", "Only a Radarr database or config is accepted; the previous database is kept until start-up.", true, "On")
+                },
+                Counters = new List<OptimizeCounter>
+                {
+                    Counter("customFormatCacheEntries", "Custom format cache entries", CustomFormatMatchCache.Count, null),
+                    Counter("customFormatCacheHits", "Custom format cache hits", CustomFormatMatchCache.ReadCounter(ref CustomFormatMatchCache.Hits), null),
+                    Counter("customFormatCacheMisses", "Custom format cache misses", CustomFormatMatchCache.ReadCounter(ref CustomFormatMatchCache.Misses), null),
+                    Counter("customFormatCacheEvictions", "Custom format cache entries dropped (full)", CustomFormatMatchCache.ReadCounter(ref CustomFormatMatchCache.Evictions), null),
+                    Counter("customFormatCacheExpirations", "Custom format cache entries dropped (idle)", CustomFormatMatchCache.ReadCounter(ref CustomFormatMatchCache.Expirations), null),
+                    Counter("ffprobeCacheEntries", "ffprobe cache entries", probeCache?.Count ?? 0, null),
+                    Counter("ffprobeCacheBytes", "ffprobe cache memory (estimated)", (probeCache?.Bytes ?? 0) / 1024, "KB"),
+                    Counter("ffprobeCacheHits", "ffprobe cache hits (ffprobe runs saved)", probeCache == null ? 0 : OptimizeCounters.Read(ref probeCache.Hits), null),
+                    Counter("ffprobeCacheMisses", "ffprobe cache misses", probeCache == null ? 0 : OptimizeCounters.Read(ref probeCache.Misses), null),
+                    Counter("ffprobeTimeouts", "ffprobe runs stopped by the timeout", OptimizeCounters.Read(ref OptimizeCounters.FfprobeTimeouts), null),
+                    Counter("cacheHitResponses", "Indexer responses marked as cache hits", OptimizeCounters.Read(ref OptimizeCounters.CacheHitResponses), null),
+                    Counter("rateLimitRefunds", "Rate-limit waits given back (cache hits)", OptimizeCounters.Read(ref OptimizeCounters.Refunds), null),
+                    Counter("rateLimitRefundsKept", "Cache hits whose wait was kept (next slot already taken)", OptimizeCounters.Read(ref OptimizeCounters.RefundsKept), null),
+                    Counter("rateLimitTimeSaved", "Wait time given back by cache hits", OptimizeCounters.Read(ref OptimizeCounters.RefundedTicks) / TimeSpan.TicksPerMillisecond, "ms"),
+                    Counter("pacedRequests", "Indexer requests paced by the cache-hit limiter", OptimizeCounters.Read(ref OptimizeCounters.PacedRequests), null),
+                    Counter("pacedRequestsWaited", "...of which waited for the rate limit", OptimizeCounters.Read(ref OptimizeCounters.PacedRequestsWaited), null),
+                    Counter("pacedWaitTime", "...total time they waited", OptimizeCounters.Read(ref OptimizeCounters.PacedWaitTicks) / TimeSpan.TicksPerMillisecond, "ms")
+                }
+            };
+
+            return status;
+        }
+
+        public void Handle(ApplicationStartedEvent message)
+        {
+            Reload();
+        }
+
+        public void Handle(ConfigSavedEvent message)
+        {
+            Reload();
+        }
+
+        private static bool TryGetValue(IDictionary<string, object> values, OptimizeTunable tunable, out object value)
+        {
+            foreach (var pair in values)
+            {
+                if (string.Equals(pair.Key, tunable.Name, StringComparison.OrdinalIgnoreCase))
+                {
+                    value = pair.Value;
+
+                    return true;
+                }
+            }
+
+            value = null;
+
+            return false;
+        }
+
+        private void ApplyLimits()
+        {
+            CustomFormatMatchCache.ApplyLimits();
+            (_videoFileInfoReader as VideoFileInfoReader)?.ApplyCacheLimits();
+        }
+
+        private void LogChanges(OptimizeSettings previous, OptimizeSettings settings)
+        {
+            foreach (var tunable in OptimizeTunables.Editable)
+            {
+                var before = previous.ValueOf(tunable);
+                var after = settings.ValueOf(tunable);
+
+                if (!Equals(before, after))
+                {
+                    var source = settings[tunable.Name].Source;
+                    var unit = tunable.Unit == null ? string.Empty : " " + tunable.Unit;
+
+                    _logger.Info("{0} is now {1}{2}, {3}", tunable.Label, LogText(tunable, after), unit,
+                        source == OptimizeValueSource.Default ? "the default" : $"{SourceText(tunable, source)} (default {LogText(tunable, tunable.DefaultValue)}{unit})");
+                }
+            }
+        }
+
+        // An empty text value turns its feature off (the cache hit header), so the log says "off" instead of nothing.
+        internal static string LogText(OptimizeTunable tunable, object value)
+        {
+            var text = tunable.Format(value);
+
+            return tunable.Kind == OptimizeValueKind.Text && string.IsNullOrEmpty(text) ? "off" : text;
+        }
+
+        private static OptimizeFeature Feature(string name, string description, bool active, string state)
+        {
+            return new OptimizeFeature { Name = name, Description = description, Active = active, State = active ? state : "Off" };
+        }
+
+        private static OptimizeCounter Counter(string name, string label, long value, string unit)
+        {
+            return new OptimizeCounter { Name = name, Label = label, Value = value, Unit = unit };
+        }
+
+        internal static string SourceText(OptimizeTunable tunable, OptimizeValueSource source)
+        {
+            return source switch
+            {
+                OptimizeValueSource.Environment => $"environment variable {tunable.EnvironmentVariable}",
+                OptimizeValueSource.Database => "saved on this page",
+                OptimizeValueSource.Fixed => "fixed in this build",
+                OptimizeValueSource.Stock => "stock setting",
+                _ => "default"
+            };
+        }
+
+        private static OptimizeSettingInfo ToInfo(OptimizeTunable tunable, OptimizeSettings settings)
+        {
+            var info = new OptimizeSettingInfo
+            {
+                Name = tunable.Name,
+                Label = tunable.Label,
+                Section = tunable.Section,
+                Main = tunable.Main,
+                Editable = tunable.Editable,
+                Kind = tunable.Kind.ToString().ToLowerInvariant(),
+                Unit = tunable.Unit,
+                Description = tunable.Description,
+                Warning = tunable.Warning,
+                WarnBelow = tunable.WarnBelow,
+                WarnAbove = tunable.WarnAbove,
+                ZeroMeans = tunable.ZeroMeans,
+                EnvironmentVariable = tunable.EnvironmentVariable,
+                Constants = tunable.Constants.ToList(),
+                DefaultValue = tunable.DefaultValue,
+                Value = settings.ValueOf(tunable)
+            };
+
+            if (tunable.Kind == OptimizeValueKind.Integer && tunable.Editable)
+            {
+                info.Min = tunable.Min;
+                info.Max = tunable.Max;
+            }
+
+            if (!tunable.Editable)
+            {
+                info.Source = tunable.ReadOnlySource.ToString().ToLowerInvariant();
+                info.SourceText = tunable.ReadOnlySource == OptimizeValueSource.Stock ? "Stock setting" : "Fixed in this build";
+                info.HowToChange = tunable.HowToChange;
+                info.Risky = false;
+
+                return info;
+            }
+
+            var effective = settings[tunable.Name];
+            info.Source = effective.Source.ToString().ToLowerInvariant();
+            info.Locked = effective.Source == OptimizeValueSource.Environment;
+            info.SavedValue = effective.SavedValue;
+            info.EnvironmentValue = effective.EnvironmentText;
+            info.EnvironmentError = effective.EnvironmentError;
+            info.Risky = tunable.IsRisky(info.Value);
+
+            // The value set (environment or page) is capped by another setting: say what is used.
+            if (!Equals(info.Value, effective.Value))
+            {
+                var unit = tunable.Unit == null ? string.Empty : " " + tunable.Unit;
+                info.Note = $"In effect: {tunable.Format(info.Value)}{unit}. The value set ({tunable.Format(effective.Value)}{unit}) is capped because {tunable.CappedBy ?? "of another setting"}.";
+            }
+
+            var environmentHint = tunable.EnvironmentVariable == null
+                ? string.Empty
+                : $" or set environment variable {tunable.EnvironmentVariable} on the container and recreate it";
+
+            switch (effective.Source)
+            {
+                case OptimizeValueSource.Environment:
+                    info.SourceText = $"Set by environment variable {tunable.EnvironmentVariable}";
+                    info.HowToChange = $"Change or remove environment variable {tunable.EnvironmentVariable} on the container and recreate it; " +
+                                       "while it is set, this page cannot change the value." +
+                                       (effective.SavedValue != null ? $" A value saved on this page ({tunable.Format(effective.SavedValue)}) is used once the variable is removed." : string.Empty);
+                    break;
+                case OptimizeValueSource.Database:
+                    info.SourceText = "Saved on this page";
+                    info.HowToChange = "Change it on this page (applies at once, no restart)" + environmentHint + ".";
+                    break;
+                default:
+                    info.SourceText = "Default";
+                    info.HowToChange = "Change it on this page (applies at once, no restart)" + environmentHint + ".";
+                    break;
+            }
+
+            if (effective.EnvironmentError != null)
+            {
+                info.HowToChange += $" Environment variable {tunable.EnvironmentVariable} is set to '{effective.EnvironmentText}' but ignored: {effective.EnvironmentError}.";
+            }
+
+            return info;
+        }
+    }
+
+    public class OptimizeSettingInfo
+    {
+        public string Name { get; set; }
+        public string Label { get; set; }
+        public string Section { get; set; }
+        public bool Main { get; set; }
+        public bool Editable { get; set; }
+        public string Kind { get; set; }
+        public string Unit { get; set; }
+        public long? Min { get; set; }
+        public long? Max { get; set; }
+        public object Value { get; set; }
+        public object DefaultValue { get; set; }
+        public object SavedValue { get; set; }
+        public string Source { get; set; }
+        public string SourceText { get; set; }
+        public bool Locked { get; set; }
+        public string EnvironmentVariable { get; set; }
+        public string EnvironmentValue { get; set; }
+        public string EnvironmentError { get; set; }
+        public string Description { get; set; }
+        public string Warning { get; set; }
+        public long? WarnBelow { get; set; }
+        public long? WarnAbove { get; set; }
+        public bool Risky { get; set; }
+        public string ZeroMeans { get; set; }
+        public string HowToChange { get; set; }
+
+        // Set when the value in effect differs from the value set (capped by another setting).
+        public string Note { get; set; }
+        public List<string> Constants { get; set; }
+    }
+
+    public class OptimizeStatus
+    {
+        public DateTime StartedUtc { get; set; }
+        public List<OptimizeFeature> Features { get; set; }
+        public List<OptimizeCounter> Counters { get; set; }
+    }
+
+    public class OptimizeFeature
+    {
+        public string Name { get; set; }
+        public string Description { get; set; }
+        public bool Active { get; set; }
+        public string State { get; set; }
+    }
+
+    public class OptimizeCounter
+    {
+        public string Name { get; set; }
+        public string Label { get; set; }
+        public long Value { get; set; }
+        public string Unit { get; set; }
+    }
+}
diff --git a/src/NzbDrone.Core/Optimize/OptimizeTunable.cs b/src/NzbDrone.Core/Optimize/OptimizeTunable.cs
new file mode 100644
index 000000000..e17e9d773
--- /dev/null
+++ b/src/NzbDrone.Core/Optimize/OptimizeTunable.cs
@@ -0,0 +1,185 @@
+using System;
+using System.Globalization;
+
+namespace NzbDrone.Core.Optimize
+{
+    public enum OptimizeValueKind
+    {
+        Integer,
+        Text,
+        Boolean
+    }
+
+    public enum OptimizeValueSource
+    {
+        // Not set anywhere: the built-in default.
+        Default,
+
+        // Saved on the Optimize settings page (Config table, key "optimize<Name>").
+        Database,
+
+        // Set by the environment variable of the setting; the page shows it read-only.
+        Environment,
+
+        // Cannot be changed while the app runs (fixed in this build, or derived from another setting).
+        Fixed,
+
+        // Read-only here because it follows a stock setting of the app, which is changed where the stock app changes it.
+        Stock
+    }
+
+    // One tunable value of the optimization patches: its bounds, default, environment variable, and the text the
+    // Optimize page shows for it. Editable tunables are stored in the Config table as "optimize<Name>".
+    public class OptimizeTunable
+    {
+        public string Name { get; init; }
+        public string Label { get; init; }
+        public string Section { get; init; }
+
+        // Shown in the top "Optimize" fieldset (the four main settings); the others are under "Advanced tuning".
+        public bool Main { get; init; }
+        public bool Editable { get; init; } = true;
+        public OptimizeValueKind Kind { get; init; }
+        public string Unit { get; init; }
+
+        // Bounds of a value saved on the page.
+        public long Min { get; init; }
+        public long Max { get; init; }
+
+        // Bounds of the environment variable, when they differ from the page (kept from earlier releases).
+        public long? EnvironmentMin { get; init; }
+        public long? EnvironmentMax { get; init; }
+
+        // long for Integer, string for Text, bool for Boolean.
+        public object DefaultValue { get; init; }
+        public string EnvironmentVariable { get; init; }
+        public string Description { get; init; }
+
+        // Shown next to the field when the value is in the risky range (below WarnBelow, above WarnAbove, or for a
+        // Boolean when it is not the default).
+        public string Warning { get; init; }
+        public long? WarnBelow { get; init; }
+        public long? WarnAbove { get; init; }
+
+        // Why the value in effect can be lower than the one set (shown when it is).
+        public string CappedBy { get; init; }
+
+        // What a value of 0 means, when 0 is special ("disables the cache").
+        public string ZeroMeans { get; init; }
+
+        // The code constants this tunable replaces or derives from ("Class.Member"); their values are the defaults.
+        public string[] Constants { get; init; } = Array.Empty<string>();
+
+        // For a value that cannot be changed on the page: why, and how to change it.
+        public string HowToChange { get; init; }
+
+        // For read-only rows: the value in effect, computed at runtime.
+        public Func<OptimizeSettings, object> ReadOnlyValue { get; init; }
+
+        // For read-only rows: where the value comes from (fixed in this build, or a stock setting of the app).
+        public OptimizeValueSource ReadOnlySource { get; init; } = OptimizeValueSource.Fixed;
+
+        public string ConfigKey => "Optimize" + char.ToUpperInvariant(Name[0]) + Name.Substring(1);
+
+        public long MinFor(bool fromEnvironment)
+        {
+            return fromEnvironment && EnvironmentMin.HasValue ? EnvironmentMin.Value : Min;
+        }
+
+        public long MaxFor(bool fromEnvironment)
+        {
+            return fromEnvironment && EnvironmentMax.HasValue ? EnvironmentMax.Value : Max;
+        }
+
+        // Parses and validates a value. Returns null when valid, otherwise a message for the user.
+        public string TryParse(string text, bool fromEnvironment, out object value)
+        {
+            value = null;
+            var trimmed = text?.Trim() ?? string.Empty;
+
+            switch (Kind)
+            {
+                case OptimizeValueKind.Integer:
+                    {
+                        var min = MinFor(fromEnvironment);
+                        var max = MaxFor(fromEnvironment);
+
+                        // Digits only: no sign, no decimals, no thousands separators.
+                        if (!long.TryParse(trimmed, NumberStyles.None, CultureInfo.InvariantCulture, out var number) || number < min || number > max)
+                        {
+                            return string.Format(CultureInfo.InvariantCulture, "{0} must be a whole number from {1} to {2}", Label, min, max);
+                        }
+
+                        value = number;
+
+                        return null;
+                    }
+
+                case OptimizeValueKind.Boolean:
+                    {
+                        if (trimmed.Equals("true", StringComparison.OrdinalIgnoreCase) || trimmed.Equals("yes", StringComparison.OrdinalIgnoreCase) ||
+                            trimmed.Equals("on", StringComparison.OrdinalIgnoreCase) || trimmed == "1")
+                        {
+                            value = true;
+
+                            return null;
+                        }
+
+                        if (trimmed.Equals("false", StringComparison.OrdinalIgnoreCase) || trimmed.Equals("no", StringComparison.OrdinalIgnoreCase) ||
+                            trimmed.Equals("off", StringComparison.OrdinalIgnoreCase) || trimmed == "0")
+                        {
+                            value = false;
+
+                            return null;
+                        }
+
+                        return $"{Label} must be true or false";
+                    }
+
+                default:
+                    {
+                        var error = OptimizeTunables.ValidateText(this, trimmed);
+
+                        if (error == null)
+                        {
+                            value = trimmed;
+                        }
+
+                        return error;
+                    }
+            }
+        }
+
+        public string Format(object value)
+        {
+            return value switch
+            {
+                null => string.Empty,
+                bool b => b ? "true" : "false",
+                long l => l.ToString(CultureInfo.InvariantCulture),
+                int i => i.ToString(CultureInfo.InvariantCulture),
+                _ => value.ToString()
+            };
+        }
+
+        public bool IsRisky(object value)
+        {
+            if (Warning == null || value == null)
+            {
+                return false;
+            }
+
+            if (Kind == OptimizeValueKind.Boolean)
+            {
+                return !Equals(value, DefaultValue);
+            }
+
+            if (value is long number)
+            {
+                return (WarnBelow.HasValue && number < WarnBelow.Value) || (WarnAbove.HasValue && number > WarnAbove.Value);
+            }
+
+            return false;
+        }
+    }
+}
diff --git a/src/NzbDrone.Core/Optimize/OptimizeTunables.cs b/src/NzbDrone.Core/Optimize/OptimizeTunables.cs
new file mode 100644
index 000000000..640551f78
--- /dev/null
+++ b/src/NzbDrone.Core/Optimize/OptimizeTunables.cs
@@ -0,0 +1,520 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using NzbDrone.Core.CustomFormats;
+using NzbDrone.Core.Indexers;
+using NzbDrone.Core.MediaFiles.MediaInfo;
+
+namespace NzbDrone.Core.Optimize
+{
+    // Every value the optimization patches add or rely on. The Optimize page and its API list exactly these, with their
+    // effective values computed at runtime, so the page cannot drift from the code. A new tunable is added here.
+    public static class OptimizeTunables
+    {
+        public const string IndexerRateLimitMs = "indexerRateLimitMs";
+        public const string CacheHitHeader = "cacheHitHeader";
+        public const string CacheHitValue = "cacheHitValue";
+        public const string FfprobeTimeoutMinutes = "ffprobeTimeoutMinutes";
+
+        public const string GrabSpacingMs = "grabSpacingMs";
+        public const string CustomFormatCacheCapacity = "customFormatCacheCapacity";
+        public const string CustomFormatCacheExpiryMinutes = "customFormatCacheExpiryMinutes";
+        public const string CustomFormatCacheMaxInputChars = "customFormatCacheMaxInputChars";
+        public const string DecisionBatchMemo = "decisionBatchMemo";
+        public const string ReleaseProfileCache = "releaseProfileCache";
+        public const string FfprobeCacheEntries = "ffprobeCacheEntries";
+        public const string FfprobeCacheMaxMegabytes = "ffprobeCacheMaxMegabytes";
+        public const string FfprobeCacheMaxEntryKilobytes = "ffprobeCacheMaxEntryKilobytes";
+        public const string FfprobeCacheFailureMinutes = "ffprobeCacheFailureMinutes";
+        public const string FfprobeCacheIdleMinutes = "ffprobeCacheIdleMinutes";
+        public const string FfprobeCacheSettleSeconds = "ffprobeCacheSettleSeconds";
+        public const string FfprobeCacheUnsettledSeconds = "ffprobeCacheUnsettledSeconds";
+        public const string FfprobeCacheSweepSeconds = "ffprobeCacheSweepSeconds";
+
+        public const string FfprobeCacheEvictionBatch = "ffprobeCacheEvictionBatch";
+        public const string IndexerBuiltInLimits = "indexerBuiltInLimits";
+        public const string ImportRetryInterval = "importRetryInterval";
+        public const string ProviderSettingsTypeCache = "providerSettingsTypeCache";
+        public const string HousekeepingMaxDeferral = "housekeepingMaxDeferral";
+
+        public const string FfprobeTimeoutVariable = "ARR_FFPROBE_TIMEOUT_MINUTES";
+
+        // The default ffprobe timeout: next3 shipped a fixed 5 minutes, which stopped slow probes of large remote files.
+        public const int DefaultFfprobeTimeoutMinutes = 15;
+
+        public static readonly IReadOnlyList<OptimizeTunable> All = Build();
+
+        public static readonly IReadOnlyList<OptimizeTunable> Editable = All.Where(t => t.Editable).ToList();
+
+        private static readonly Dictionary<string, OptimizeTunable> ByName = All.ToDictionary(t => t.Name, StringComparer.OrdinalIgnoreCase);
+
+        public static OptimizeTunable Get(string name)
+        {
+            return ByName.TryGetValue(name, out var tunable) ? tunable : null;
+        }
+
+        internal static string ValidateText(OptimizeTunable tunable, string text)
+        {
+            if (tunable.Name == CacheHitHeader)
+            {
+                if (text.Length == 0)
+                {
+                    return null;
+                }
+
+                if (text.Length > 256 || !IsHeaderName(text))
+                {
+                    return "Cache hit header must be a valid HTTP header name (letters, digits and !#$%&'*+-.^_`|~ only), at most 256 characters";
+                }
+
+                return null;
+            }
+
+            if (tunable.Name == CacheHitValue)
+            {
+                if (text.Length == 0)
+                {
+                    return null;
+                }
+
+                if (text.Length > 256 || text.IndexOfAny(new[] { ',', ';' }) >= 0 || text.Any(char.IsControl))
+                {
+                    return "Cache hit value must be a single value without ',' or ';', at most 256 characters";
+                }
+
+                return null;
+            }
+
+            return null;
+        }
+
+        // RFC 9110 token characters.
+        private static bool IsHeaderName(string name)
+        {
+            foreach (var c in name)
+            {
+                var isToken = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || "!#$%&'*+-.^_`|~".IndexOf(c) >= 0;
+
+                if (!isToken)
+                {
+                    return false;
+                }
+            }
+
+            return name.Length > 0;
+        }
+
+        private static List<OptimizeTunable> Build()
+        {
+            var list = new List<OptimizeTunable>
+            {
+                new OptimizeTunable
+                {
+                    Name = IndexerRateLimitMs,
+                    Label = "Indexer request spacing",
+                    Section = "Indexers",
+                    Main = true,
+                    Kind = OptimizeValueKind.Integer,
+                    Unit = "ms",
+                    Min = 0,
+                    Max = 10_000,
+                    EnvironmentMax = (long)TimeSpan.FromDays(1).TotalMilliseconds,
+                    DefaultValue = (long)IndexerRateLimitOptions.StockRateLimit.TotalMilliseconds,
+                    EnvironmentVariable = IndexerRateLimitOptions.RateLimitVariable,
+                    Description = "The minimum time between two requests to the same indexer (searches, RSS and paging). Stock is 2000 ms. " +
+                                  "Indexer types with their own built-in limit (PassThePopcorn: 4000 ms) keep it. If your indexers are added " +
+                                  "through Prowlarr, Prowlarr still applies its own limits to the real indexers.",
+                    Warning = "Lower than stock: an indexer you reach directly may rate-limit you (HTTP 429) and return fewer results. " +
+                              "Only lower it for indexers that allow it, for example a local Prowlarr or a caching proxy.",
+                    WarnBelow = (long)IndexerRateLimitOptions.StockRateLimit.TotalMilliseconds,
