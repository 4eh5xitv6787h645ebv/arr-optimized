+      {hasError ? (
+        <Alert kind={kinds.DANGER}>Unable to load the status.</Alert>
+      ) : null}
+
+      {!status && isFetching ? <LoadingIndicator /> : null}
+
+      {status ? (
+        <>
+          <div className={styles.counters}>
+            {status.counters.map((counter) => (
