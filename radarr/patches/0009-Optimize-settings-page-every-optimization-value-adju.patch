+using FluentValidation;
+using NzbDrone.Core.Optimize;
+
+namespace Radarr.Api.V3.Config
+{
+    // Bounds and formats of every editable value, from the same definitions the app uses for the environment variables.
+    // Values whose environment variable is set are not validated: PUT ignores them.
+    public class OptimizeConfigResourceValidator : AbstractValidator<OptimizeConfigResource>
+    {
+        public OptimizeConfigResourceValidator(IOptimizeSettingsService optimizeSettingsService)
+        {
+            RuleFor(r => r).Custom((resource, context) =>
+            {
+                foreach (var error in optimizeSettingsService.Validate(resource.ToValues()))
+                {
+                    var tunable = OptimizeTunables.Get(error.Key);
+                    var propertyName = char.ToUpperInvariant(tunable.Name[0]) + tunable.Name.Substring(1);
+
+                    context.AddFailure(propertyName, error.Value);
+                }
+            });
+        }
+    }
+}
