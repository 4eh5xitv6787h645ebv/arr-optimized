diff --git a/src/NzbDrone.Core/Optimize/OptimizeCounters.cs b/src/NzbDrone.Core/Optimize/OptimizeCounters.cs
new file mode 100644
index 000000000..dbb1ab8ca
--- /dev/null
+++ b/src/NzbDrone.Core/Optimize/OptimizeCounters.cs
@@ -0,0 +1,44 @@
+using System;
+using System.Threading;
+
+namespace NzbDrone.Core.Optimize
+{
+    // Counters since start-up for the Optimize status page. Updated with Interlocked only; no locks on hot paths.
+    public static class OptimizeCounters
+    {
+        public static readonly DateTime StartedUtc = DateTime.UtcNow;
+
+        // Indexer responses that carried the cache hit header with the cache hit value.
+        internal static long CacheHitResponses;
+
+        // Cache hits whose rate-limit slot was given back, and those whose slot was kept because a later request had
+        // already reserved the next one.
+        internal static long Refunds;
+        internal static long RefundsKept;
+
+        // Rate-limit time handed back by refunds, in ticks.
+        internal static long RefundedTicks;
+
+        // Indexer requests paced by the cache-hit limiter (only while the cache hit header is set; otherwise requests are
+        // paced inside HttpClient exactly as on stock and are not counted here), how many of them waited, and for how long.
+        internal static long PacedRequests;
+        internal static long PacedRequestsWaited;
+        internal static long PacedWaitTicks;
+
+        // ffprobe runs stopped by the ffprobe timeout.
+        internal static long FfprobeTimeouts;
+
+        internal static void Add(ref long counter, TimeSpan time)
+        {
+            if (time > TimeSpan.Zero)
+            {
+                Interlocked.Add(ref counter, time.Ticks);
+            }
+        }
+
+        internal static long Read(ref long counter)
+        {
+            return Interlocked.Read(ref counter);
+        }
+    }
+}
diff --git a/src/NzbDrone.Core/Optimize/OptimizeSettings.cs b/src/NzbDrone.Core/Optimize/OptimizeSettings.cs
new file mode 100644
index 000000000..2987f7ae8
--- /dev/null
+++ b/src/NzbDrone.Core/Optimize/OptimizeSettings.cs
@@ -0,0 +1,368 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using NLog;
+using NzbDrone.Common.Instrumentation;
+using NzbDrone.Core.Indexers;
+
+namespace NzbDrone.Core.Optimize
+{
+    public class OptimizeEffectiveValue
+    {
+        public object Value { get; init; }
+        public OptimizeValueSource Source { get; init; }
+
+        // The value saved on the page (null when none), also when an environment variable overrides it.
+        public object SavedValue { get; init; }
+
+        // The raw environment variable, when it is set (valid or not).
+        public string EnvironmentText { get; init; }
+
+        // Why the environment variable is ignored, when it is set but invalid.
+        public string EnvironmentError { get; init; }
+    }
+
+    // Limits of the ffprobe result cache (MediaInfoProbeCache), in the units the cache works with.
+    public sealed class MediaInfoProbeCacheLimits
+    {
+        public int Capacity { get; init; }
+        public long MaxBytes { get; init; }
+        public long MaxEntryBytes { get; init; }
+        public long FailureLifetimeMs { get; init; }
+        public long IdleLifetimeMs { get; init; }
+        public TimeSpan SettleTime { get; init; }
+        public long UnsettledLifetimeMs { get; init; }
+        public long SweepIntervalMs { get; init; }
+
+        public bool Enabled => Capacity > 0 && MaxBytes > 0;
+    }
+
+    // An immutable snapshot of every optimization setting in effect. Hot paths read OptimizeSettings.Current (one
+    // volatile read) and then only fields of the snapshot; a change builds a new snapshot and swaps it in, so a reader
+    // never sees a half-applied change. Precedence per value: a valid environment variable, then the value saved on
+    // the Optimize page (Config table), then the built-in default (the stock behaviour or the tested default).
+    public sealed class OptimizeSettings
+    {
+        private static readonly object CurrentLock = new object();
+        private static OptimizeSettings _current;
+        private static OptimizeEnvironment _environment;
+        private static Func<string, string> _lastSaved;
+
+        private readonly Dictionary<string, OptimizeEffectiveValue> _values;
+
+        private OptimizeSettings(Dictionary<string, OptimizeEffectiveValue> values, IndexerRateLimitOptions rateLimit, TimeSpan? ffprobeTimeout, int checkForFinishedDownloadInterval)
+        {
+            _values = values;
+
+            RateLimit = rateLimit ?? new IndexerRateLimitOptions(
+                TimeSpan.FromMilliseconds(Long(OptimizeTunables.IndexerRateLimitMs)),
+                Text(OptimizeTunables.CacheHitHeader),
+                Text(OptimizeTunables.CacheHitValue),
+                TimeSpan.FromMilliseconds(Long(OptimizeTunables.GrabSpacingMs)));
+
+            FfprobeTimeout = ffprobeTimeout ?? TimeSpan.FromMinutes(Long(OptimizeTunables.FfprobeTimeoutMinutes));
+
+            CustomFormatCacheCapacity = (int)Long(OptimizeTunables.CustomFormatCacheCapacity);
+            CustomFormatCacheSlidingMs = Long(OptimizeTunables.CustomFormatCacheExpiryMinutes) * 60_000;
+            CustomFormatCacheMaxInputChars = (int)Long(OptimizeTunables.CustomFormatCacheMaxInputChars);
+            DecisionBatchMemo = Bool(OptimizeTunables.DecisionBatchMemo);
+            ReleaseProfileCache = Bool(OptimizeTunables.ReleaseProfileCache);
+            CheckForFinishedDownloadInterval = checkForFinishedDownloadInterval;
+
+            var maxBytes = Long(OptimizeTunables.FfprobeCacheMaxMegabytes) * 1024 * 1024;
+
+            FfprobeCache = new MediaInfoProbeCacheLimits
+            {
+                Capacity = (int)Long(OptimizeTunables.FfprobeCacheEntries),
+                MaxBytes = maxBytes,
+                MaxEntryBytes = Math.Min(Long(OptimizeTunables.FfprobeCacheMaxEntryKilobytes) * 1024, maxBytes),
+                FailureLifetimeMs = Long(OptimizeTunables.FfprobeCacheFailureMinutes) * 60_000,
+                IdleLifetimeMs = Long(OptimizeTunables.FfprobeCacheIdleMinutes) * 60_000,
+                SettleTime = TimeSpan.FromSeconds(Long(OptimizeTunables.FfprobeCacheSettleSeconds)),
+                UnsettledLifetimeMs = Long(OptimizeTunables.FfprobeCacheUnsettledSeconds) * 1000,
+                SweepIntervalMs = Long(OptimizeTunables.FfprobeCacheSweepSeconds) * 1000
+            };
+        }
+
+        // The settings in effect. Before the app has read its database this is the environment plus the defaults.
+        public static OptimizeSettings Current
+        {
+            get
+            {
+                var current = Volatile.Read(ref _current);
+
+                if (current != null)
+                {
+                    return current;
+                }
+
+                lock (CurrentLock)
+                {
+                    if (_current == null)
+                    {
+                        Volatile.Write(ref _current, Build(Environment, _lastSaved, 1));
+                    }
+
+                    return _current;
+                }
+            }
+
+            internal set
+            {
+                lock (CurrentLock)
+                {
+                    Volatile.Write(ref _current, value);
+                }
+            }
+        }
+
+        // The environment variables, read once (they cannot change while the process runs).
+        internal static OptimizeEnvironment Environment
+        {
+            get
+            {
+                var environment = Volatile.Read(ref _environment);
+
+                if (environment != null)
+                {
+                    return environment;
+                }
+
+                lock (CurrentLock)
+                {
+                    _environment ??= OptimizeEnvironment.Read(System.Environment.GetEnvironmentVariable, NzbDroneLogger.GetLogger(typeof(OptimizeSettings)));
+
+                    return _environment;
+                }
+            }
+        }
+
+        public IndexerRateLimitOptions RateLimit { get; }
+        public TimeSpan FfprobeTimeout { get; }
+        public int CustomFormatCacheCapacity { get; }
+        public long CustomFormatCacheSlidingMs { get; }
+        public int CustomFormatCacheMaxInputChars { get; }
+        public bool DecisionBatchMemo { get; }
+        public bool ReleaseProfileCache { get; }
+        public MediaInfoProbeCacheLimits FfprobeCache { get; }
+        public int CheckForFinishedDownloadInterval { get; }
+
+        public IReadOnlyDictionary<string, OptimizeEffectiveValue> Values => _values;
+
+        public OptimizeEffectiveValue this[string name] => _values[name];
+
+        public bool IsLocked(string name)
+        {
+            return _values.TryGetValue(name, out var value) && value.Source == OptimizeValueSource.Environment;
+        }
+
+        // Builds and publishes the snapshot for the given saved values (a lookup by config key; null = nothing saved).
+        public static OptimizeSettings Load(Func<string, string> saved, int checkForFinishedDownloadInterval)
+        {
+            lock (CurrentLock)
+            {
+                _lastSaved = saved;
+                var settings = Build(Environment, saved, checkForFinishedDownloadInterval);
+                Volatile.Write(ref _current, settings);
+
+                return settings;
+            }
+        }
+
+        // Test hook: read the environment again and rebuild from the last saved values.
+        internal static void ResetEnvironment()
+        {
+            lock (CurrentLock)
+            {
+                _environment = null;
+                _current = null;
+            }
+        }
+
+        // Test hook: forget saved values and environment; the next read is the defaults plus the environment.
+        internal static void Reset()
+        {
+            lock (CurrentLock)
+            {
+                _environment = null;
+                _lastSaved = null;
+                _current = null;
+            }
+        }
+
+        public static OptimizeSettings Build(OptimizeEnvironment environment, Func<string, string> saved, int checkForFinishedDownloadInterval)
+        {
+            var values = new Dictionary<string, OptimizeEffectiveValue>(StringComparer.OrdinalIgnoreCase);
+
+            foreach (var tunable in OptimizeTunables.Editable)
+            {
+                object savedValue = null;
+                var savedText = saved?.Invoke(tunable.ConfigKey);
+
+                if (!string.IsNullOrWhiteSpace(savedText) && tunable.TryParse(savedText, false, out var parsed) == null)
+                {
+                    savedValue = parsed;
+                }
+
+                environment.Texts.TryGetValue(tunable.Name, out var environmentText);
+                environment.Errors.TryGetValue(tunable.Name, out var environmentError);
+
+                OptimizeValueSource source;
+                object value;
+
+                if (environment.Values.TryGetValue(tunable.Name, out var environmentValue))
+                {
+                    source = OptimizeValueSource.Environment;
+                    value = environmentValue;
+                }
+                else if (savedValue != null)
+                {
+                    source = OptimizeValueSource.Database;
+                    value = savedValue;
+                }
+                else
+                {
+                    source = OptimizeValueSource.Default;
+                    value = tunable.DefaultValue;
+                }
+
+                values[tunable.Name] = new OptimizeEffectiveValue
+                {
+                    Value = value,
+                    Source = source,
+                    SavedValue = savedValue,
+                    EnvironmentText = environmentText,
+                    EnvironmentError = environmentError
+                };
+            }
+
+            return new OptimizeSettings(values, null, null, checkForFinishedDownloadInterval);
+        }
+
+        // Copies used by tests and by the next3 test hooks (IndexerRateLimitOptions.Current, VideoFileInfoReader.ProbeTimeout).
+        internal OptimizeSettings WithRateLimit(IndexerRateLimitOptions rateLimit)
+        {
+            return new OptimizeSettings(_values, rateLimit, FfprobeTimeout, CheckForFinishedDownloadInterval);
+        }
+
+        internal OptimizeSettings WithFfprobeTimeout(TimeSpan timeout)
+        {
+            return new OptimizeSettings(_values, RateLimit, timeout, CheckForFinishedDownloadInterval);
+        }
+
+        internal OptimizeSettings With(string name, object value)
+        {
+            var tunable = OptimizeTunables.Get(name) ?? throw new ArgumentException("Unknown optimization setting " + name, nameof(name));
+            var values = new Dictionary<string, OptimizeEffectiveValue>(_values, StringComparer.OrdinalIgnoreCase)
+            {
+                [tunable.Name] = new OptimizeEffectiveValue
+                {
+                    Value = value is int number ? (long)number : value,
+                    Source = OptimizeValueSource.Database,
+                    SavedValue = value is int saved ? (long)saved : value
+                }
+            };
+
+            return new OptimizeSettings(values, null, null, CheckForFinishedDownloadInterval);
+        }
+
+        public object ValueOf(OptimizeTunable tunable)
+        {
+            if (!tunable.Editable)
+            {
+                return tunable.ReadOnlyValue?.Invoke(this) ?? tunable.DefaultValue;
+            }
+
+            if (tunable.Name == OptimizeTunables.IndexerRateLimitMs)
+            {
+                return (long)RateLimit.BaseRateLimit.TotalMilliseconds;
+            }
+
+            if (tunable.Name == OptimizeTunables.CacheHitHeader)
+            {
+                return RateLimit.CacheHitHeader ?? string.Empty;
+            }
+
+            if (tunable.Name == OptimizeTunables.CacheHitValue)
+            {
+                return RateLimit.CacheHitValue;
+            }
+
+            if (tunable.Name == OptimizeTunables.GrabSpacingMs)
+            {
+                return (long)RateLimit.GrabSpacing.TotalMilliseconds;
+            }
+
+            if (tunable.Name == OptimizeTunables.FfprobeTimeoutMinutes)
+            {
+                return (long)FfprobeTimeout.TotalMinutes;
+            }
+
+            // Never more than the whole cache: the size in effect, not the saved one.
+            if (tunable.Name == OptimizeTunables.FfprobeCacheMaxEntryKilobytes)
+            {
+                return FfprobeCache.MaxEntryBytes / 1024;
+            }
+
+            return _values[tunable.Name].Value;
+        }
+
+        private long Long(string name)
+        {
+            return (long)_values[name].Value;
+        }
+
+        private string Text(string name)
+        {
+            return (string)_values[name].Value;
+        }
+
+        private bool Bool(string name)
+        {
+            return (bool)_values[name].Value;
+        }
+    }
+
+    // The optimization environment variables, parsed once. Invalid values are logged and ignored.
+    public sealed class OptimizeEnvironment
+    {
+        public static readonly OptimizeEnvironment Empty = new OptimizeEnvironment();
+
+        public Dictionary<string, object> Values { get; } = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
+        public Dictionary<string, string> Texts { get; } = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        public Dictionary<string, string> Errors { get; } = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+
+        public static OptimizeEnvironment Read(Func<string, string> getVariable, Logger logger)
+        {
+            var environment = new OptimizeEnvironment();
+
+            foreach (var tunable in OptimizeTunables.Editable.Where(t => t.EnvironmentVariable != null))
+            {
+                var text = getVariable(tunable.EnvironmentVariable);
+
+                if (string.IsNullOrWhiteSpace(text))
+                {
+                    continue;
+                }
+
+                environment.Texts[tunable.Name] = text;
+
+                var error = tunable.TryParse(text, true, out var value);
+
+                if (error != null)
+                {
+                    environment.Errors[tunable.Name] = error;
+                    logger?.Warn("Ignoring {0}='{1}': {2}. Using the value from the Optimize settings page or the default.", tunable.EnvironmentVariable, text, error);
+
+                    continue;
+                }
+
+                environment.Values[tunable.Name] = value;
+                logger?.Info("{0} is {1}{2}, set by environment variable {3}", tunable.Label, tunable.Format(value), tunable.Unit == null ? string.Empty : " " + tunable.Unit, tunable.EnvironmentVariable);
+            }
+
+            return environment;
+        }
+    }
+}
