diff --git a/frontend/src/Settings/Optimize/OptimizeField.tsx b/frontend/src/Settings/Optimize/OptimizeField.tsx
new file mode 100644
index 000000000..a695febe6
--- /dev/null
+++ b/frontend/src/Settings/Optimize/OptimizeField.tsx
@@ -0,0 +1,202 @@
+import React, { useCallback } from 'react';
+import FormGroup from 'Components/Form/FormGroup';
+import FormInputButton from 'Components/Form/FormInputButton';
+import FormInputGroup from 'Components/Form/FormInputGroup';
+import FormLabel from 'Components/Form/FormLabel';
+import Icon from 'Components/Icon';
+import Label from 'Components/Label';
+import { icons, inputTypes, kinds } from 'Helpers/Props';
+import { InputChanged } from 'typings/inputs';
+import { Pending } from 'typings/pending';
+import {
+  OptimizeSettingInfo,
+  OptimizeValue,
+} from 'typings/Settings/OptimizeSettings';
+import formatOptimizeValue, {
+  formatNumber,
+  isRiskyValue,
+} from './formatOptimizeValue';
+import styles from './OptimizeSettings.css';
+
+interface OptimizeFieldProps {
+  tunable: OptimizeSettingInfo;
+  setting?: Pending<OptimizeValue>;
+  onInputChange: (change: InputChanged) => void;
+}
+
+function OptimizeField({
+  tunable,
+  setting,
+  onInputChange,
+}: OptimizeFieldProps) {
+  const {
+    name,
+    label,
+    kind,
+    unit,
+    min,
+    max,
+    locked,
+    defaultValue,
+    environmentVariable,
+    environmentValue,
+    environmentError,
+    zeroMeans,
+    note,
+  } = tunable;
+
+  const isBoolean = kind === 'boolean';
+  const value = setting?.value ?? null;
+  const effectiveValue = value ?? defaultValue;
+  const isPending = !!setting?.pending;
+  const isDefault = isBoolean
+    ? effectiveValue === defaultValue
+    : value == null || value === defaultValue;
+
+  const handleResetPress = useCallback(() => {
+    onInputChange({ name, value: isBoolean ? defaultValue : null });
+  }, [name, isBoolean, defaultValue, onInputChange]);
+
+  let bounds = '';
+
+  if (kind === 'integer' && min != null && max != null) {
+    bounds = ` Allowed: ${formatNumber(min)} to ${formatNumber(max)}${
+      unit ? ` ${unit}` : ''
+    }${zeroMeans ? ` (0 = ${zeroMeans})` : ''}.`;
+  }
+
+  const defaultText = `Default: ${formatOptimizeValue(
+    tunable,
+    defaultValue
+  )}.${bounds}`;
+
+  let sourceText = `Source: ${tunable.sourceText.toLowerCase()}.`;
+
+  if (note && !isPending) {
+    sourceText = `${sourceText} ${note}`;
+  }
+
+  if (locked) {
+    sourceText = `Set by environment variable ${environmentVariable} (read-only here; change or remove it on the container and recreate it).${
+      note ? ` ${note}` : ''
+    }`;
+  } else if (isPending) {
+    sourceText = 'Not saved yet.';
+  } else if (environmentVariable) {
+    sourceText = `Source: ${tunable.sourceText.toLowerCase()}. Environment variable: ${environmentVariable}.`;
+  }
+
+  const warnings: string[] = [];
+
+  if (isRiskyValue(tunable, effectiveValue) && tunable.warning) {
+    warnings.push(tunable.warning);
+  }
+
+  if (environmentError) {
+    warnings.push(
+      `${environmentVariable}='${environmentValue}' is ignored: ${environmentError}.`
+    );
+  }
+
+  let placeholder: string | undefined = undefined;
+
+  if (kind === 'text') {
+    placeholder =
+      defaultValue === ''
+        ? 'Empty = off (default)'
+        : `${defaultValue} (default)`;
+  } else if (kind === 'integer' && typeof defaultValue === 'number') {
+    placeholder = `${defaultValue} (default)`;
+  }
+
+  const resetButton =
+    locked || isDefault ? null : (
+      <FormInputButton
+        key="reset"
+        kind={kinds.DEFAULT}
+        title="Reset to default"
+        onPress={handleResetPress}
+      >
+        <Icon name={icons.RESTORE} />
+      </FormInputButton>
+    );
+
+  const helpTextWarning = warnings.length ? warnings.join(' ') : undefined;
+  const buttons = resetButton ? [resetButton] : [];
+  let input = null;
+
+  if (isBoolean) {
+    input = (
+      <FormInputGroup
+        type={inputTypes.CHECK}
+        name={name}
+        value={effectiveValue as boolean}
+        isDisabled={locked}
+        helpText={`${tunable.description} ${defaultText} ${sourceText}`}
+        helpTextWarning={helpTextWarning}
+        buttons={buttons}
+        errors={setting?.errors}
+        warnings={setting?.warnings}
+        onChange={onInputChange}
+      />
+    );
+  } else if (kind === 'integer') {
+    input = (
+      <FormInputGroup
+        type={inputTypes.NUMBER}
+        name={name}
+        value={value as number | null}
+        min={min ?? undefined}
+        max={max ?? undefined}
+        unit={unit}
+        placeholder={placeholder}
+        readOnly={locked}
+        helpText={tunable.description}
+        helpTexts={[defaultText, sourceText]}
+        helpTextWarning={helpTextWarning}
+        buttons={buttons}
+        errors={setting?.errors}
+        warnings={setting?.warnings}
+        onChange={onInputChange}
+      />
+    );
+  } else {
+    input = (
+      <FormInputGroup
+        type={inputTypes.TEXT}
+        name={name}
+        value={(value as string | null) ?? ''}
+        placeholder={placeholder}
+        readOnly={locked}
+        helpText={tunable.description}
+        helpTexts={[defaultText, sourceText]}
+        helpTextWarning={helpTextWarning}
+        buttons={buttons}
+        errors={setting?.errors}
+        warnings={setting?.warnings}
+        onChange={onInputChange}
+      />
+    );
+  }
+
+  return (
+    <FormGroup>
+      <FormLabel>
+        {label}
+        {locked ? (
+          <Label
+            className={styles.lockedLabel}
+            kind={kinds.WARNING}
+            title={`Set by environment variable ${environmentVariable}`}
+          >
+            ENV
+          </Label>
+        ) : null}
+      </FormLabel>
+
+      {input}
+    </FormGroup>
+  );
+}
+
+export default OptimizeField;
