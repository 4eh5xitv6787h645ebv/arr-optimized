+import classNames from 'classnames';
+import React from 'react';
+import { OptimizeSettingInfo } from 'typings/Settings/OptimizeSettings';
+import formatOptimizeValue from './formatOptimizeValue';
+import styles from './OptimizeSettings.css';
+
+interface OptimizeSettingsListProps {
+  tunables: OptimizeSettingInfo[];
+}
+
+function groupBySection(tunables: OptimizeSettingInfo[]) {
+  const sections: [string, OptimizeSettingInfo[]][] = [];
+
+  tunables.forEach((tunable) => {
+    const existing = sections.find(([section]) => section === tunable.section);
+
+    if (existing) {
+      existing[1].push(tunable);
+    } else {
+      sections.push([tunable.section, [tunable]]);
+    }
+  });
+
+  return sections;
+}
+
+function getSource(tunable: OptimizeSettingInfo) {
+  if (!tunable.editable) {
+    // "Fixed in this build", or "Stock setting" for a value that follows a
+    // setting of the stock app (its how-to-change text says where).
+    return tunable.sourceText;
+  }
+
+  if (tunable.locked) {
+    return `Environment variable ${tunable.environmentVariable} (locked)`;
+  }
+
+  return tunable.source === 'database' ? 'Saved on this page' : 'Default';
+}
+
+function OptimizeSettingsList({ tunables }: OptimizeSettingsListProps) {
+  return (
+    <div className={styles.list}>
+      <div className={styles.listIntro}>
+        Every value the optimizations in this build add or rely on, read from
+        the running app. Editable values can be changed above; the others say
+        how they can be changed.
+      </div>
+
+      {groupBySection(tunables).map(([section, items]) => {
+        return (
+          <div key={section} className={styles.listSection}>
+            <div className={styles.listSectionTitle}>{section}</div>
+
+            <div className={styles.listHeader}>
+              <div>Setting</div>
+              <div>Current</div>
+              <div>Default</div>
+              <div>Source and how to change it</div>
+            </div>
+
+            {items.map((tunable) => {
+              const isChanged =
+                tunable.editable && tunable.source !== 'default';
+
+              return (
+                <div key={tunable.name} className={styles.row}>
+                  <div>
+                    <div className={styles.rowName}>{tunable.label}</div>
+                    <div className={styles.rowDescription}>
+                      {tunable.description}
+                    </div>
+                  </div>
+
+                  <div
+                    className={classNames(
+                      styles.rowValue,
+                      isChanged && styles.changed,
+                      tunable.risky && styles.risky
+                    )}
+                  >
+                    <span className={styles.cellLabel}>Current:</span>
+                    {formatOptimizeValue(tunable, tunable.value)}
+                  </div>
+
+                  <div className={styles.rowValue}>
+                    <span className={styles.cellLabel}>Default:</span>
+                    {formatOptimizeValue(tunable, tunable.defaultValue)}
+                  </div>
+
+                  <div className={styles.rowMeta}>
+                    <div
+                      className={classNames(
+                        styles.rowSource,
+                        tunable.locked && styles.locked
+                      )}
+                    >
+                      {getSource(tunable)}
+                    </div>
+
+                    {tunable.note ? (
+                      <div className={styles.risky}>{tunable.note}</div>
+                    ) : null}
+
+                    {tunable.howToChange ? (
+                      <div>{tunable.howToChange}</div>
+                    ) : null}
+
+                    {tunable.environmentVariable && !tunable.locked ? (
+                      <div>
+                        Environment variable:{' '}
+                        <code className={styles.code}>
+                          {tunable.environmentVariable}
+                        </code>
+                      </div>
+                    ) : null}
+
+                    {tunable.constants.length ? (
+                      <div>
+                        Code:{' '}
+                        {tunable.constants.map((constant, index) => (
+                          <React.Fragment key={constant}>
+                            {index > 0 ? ', ' : null}
+                            <code className={styles.code}>{constant}</code>
+                          </React.Fragment>
+                        ))}
+                      </div>
+                    ) : null}
+                  </div>
+                </div>
+              );
+            })}
+          </div>
+        );
+      })}
+    </div>
+  );
+}
+
+export default OptimizeSettingsList;
