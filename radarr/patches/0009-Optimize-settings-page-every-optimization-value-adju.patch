+export type OptimizeValue = number | string | boolean | null;
+
+export type OptimizeValueSource =
+  | 'default'
+  | 'database'
+  | 'environment'
+  | 'fixed'
+  | 'stock';
+
+export interface OptimizeSettingInfo {
+  name: string;
+  label: string;
+  section: string;
+  main: boolean;
+  editable: boolean;
+  kind: 'integer' | 'text' | 'boolean';
+  unit?: string;
+  min?: number;
+  max?: number;
+  value: OptimizeValue;
+  defaultValue: OptimizeValue;
+  savedValue?: OptimizeValue;
+  source: OptimizeValueSource;
+  sourceText: string;
+  locked: boolean;
+  environmentVariable?: string;
+  environmentValue?: string;
+  environmentError?: string;
+  description: string;
+  warning?: string;
+  warnBelow?: number;
+  warnAbove?: number;
+  risky: boolean;
+  zeroMeans?: string;
+  howToChange?: string;
+  note?: string;
+  constants: string[];
+}
+
+export interface OptimizeFeature {
+  name: string;
+  description: string;
+  active: boolean;
+  state: string;
+}
+
+export interface OptimizeCounter {
+  name: string;
+  label: string;
+  value: number;
+  unit?: string;
+}
+
+export interface OptimizeStatus {
+  startedUtc: string;
+  features: OptimizeFeature[];
+  counters: OptimizeCounter[];
+}
+
+export default interface OptimizeSettings {
+  id: number;
+  indexerRateLimitMs: number | null;
+  cacheHitHeader: string | null;
+  cacheHitValue: string | null;
+  ffprobeTimeoutMinutes: number | null;
+  grabSpacingMs: number | null;
+  customFormatCacheCapacity: number | null;
+  customFormatCacheExpiryMinutes: number | null;
+  customFormatCacheMaxInputChars: number | null;
+  decisionBatchMemo: boolean | null;
+  releaseProfileCache: boolean | null;
+  ffprobeCacheEntries: number | null;
+  ffprobeCacheMaxMegabytes: number | null;
+  ffprobeCacheMaxEntryKilobytes: number | null;
+  ffprobeCacheFailureMinutes: number | null;
+  ffprobeCacheIdleMinutes: number | null;
+  ffprobeCacheSettleSeconds: number | null;
+  ffprobeCacheUnsettledSeconds: number | null;
+  ffprobeCacheSweepSeconds: number | null;
+  tunables: OptimizeSettingInfo[];
+}
