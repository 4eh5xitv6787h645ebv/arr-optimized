@@ -0,0 +1,233 @@
+import React, { useCallback, useEffect, useMemo } from 'react';
+import { useDispatch, useSelector } from 'react-redux';
+import AppState from 'App/State/AppState';
+import Alert from 'Components/Alert';
+import FieldSet from 'Components/FieldSet';
+import Form from 'Components/Form/Form';
+import LoadingIndicator from 'Components/Loading/LoadingIndicator';
+import PageContent from 'Components/Page/PageContent';
+import PageContentBody from 'Components/Page/PageContentBody';
+import useApiQuery from 'Helpers/Hooks/useApiQuery';
+import usePrevious from 'Helpers/Hooks/usePrevious';
+import { kinds } from 'Helpers/Props';
+import SettingsToolbar from 'Settings/SettingsToolbar';
+import { clearPendingChanges } from 'Store/Actions/baseActions';
+import {
+  fetchOptimizeSettings,
+  saveOptimizeSettings,
+  setOptimizeSettingsValue,
+} from 'Store/Actions/settingsActions';
+import createSettingsSectionSelector from 'Store/Selectors/createSettingsSectionSelector';
+import { InputChanged } from 'typings/inputs';
+import { Pending } from 'typings/pending';
+import {
+  OptimizeSettingInfo,
+  OptimizeStatus,
+  OptimizeValue,
+} from 'typings/Settings/OptimizeSettings';
+import OptimizeField from './OptimizeField';
+import OptimizeSettingsList from './OptimizeSettingsList';
+import OptimizeStatusSection from './OptimizeStatusSection';
+import styles from './OptimizeSettings.css';
+
+const SECTION = 'optimize';
+
+function OptimizeSettings() {
+  const dispatch = useDispatch();
+
+  const {
+    isFetching,
+    isPopulated,
+    isSaving,
+    error,
+    saveError,
+    settings,
+    hasSettings,
+    hasPendingChanges,
+    validationErrors,
+    validationWarnings,
+  } = useSelector(createSettingsSectionSelector(SECTION));
+
+  const {
+    data: status,
+    isFetching: isFetchingStatus,
+    isError: hasStatusError,
+    refetch: refetchStatus,
+  } = useApiQuery<OptimizeStatus>({
+    path: '/config/optimize/status',
+    queryOptions: {
+      refetchOnWindowFocus: false,
+    },
+  });
+
+  const item = useSelector(
+    (state: AppState) => state.settings.optimize.item
+  ) as unknown as Record<string, OptimizeValue | undefined>;
+
+  const pendingChanges = useSelector(
+    (state: AppState) => state.settings.optimize.pendingChanges
+  ) as unknown as Record<string, OptimizeValue | undefined>;
+
+  const wasSaving = usePrevious(isSaving);
+
+  const tunables: OptimizeSettingInfo[] = useMemo(() => {
+    return settings.tunables?.value ?? [];
+  }, [settings.tunables]);
+
+  const mainTunables = useMemo(
+    () => tunables.filter((t) => t.editable && t.main),
+    [tunables]
+  );
+
+  const advancedSections = useMemo(() => {
+    const sections: [string, OptimizeSettingInfo[]][] = [];
+
+    tunables
+      .filter((t) => t.editable && !t.main)
+      .forEach((tunable) => {
+        const existing = sections.find(([name]) => name === tunable.section);
+
+        if (existing) {
+          existing[1].push(tunable);
+        } else {
+          sections.push([tunable.section, [tunable]]);
+        }
+      });
+
+    return sections;
+  }, [tunables]);
+
+  const handleInputChange = useCallback(
+    (change: InputChanged) => {
+      // The API leaves out values that are not set (null). Clearing a field, or resetting it to its
+      // default, gives back that same "not set" value, so it is not an unsaved change.
+      const value =
+        change.value == null && item[change.name] == null
+          ? item[change.name]
+          : change.value;
+
+      // @ts-expect-error - actions aren't typed
+      dispatch(setOptimizeSettingsValue({ ...change, value }));
+    },
+    [item, dispatch]
+  );
+
+  const handleSavePress = useCallback(() => {
+    // PUT changes only the values in the body; an explicit null resets a value to its default (as in the Sonarr
+    // image). A field that was cleared or reset on this page is sent as null.
+    const payload: Record<string, OptimizeValue> = {};
+
+    Object.keys(pendingChanges ?? {}).forEach((name) => {
+      const value = pendingChanges[name];
+      const tunable = tunables.find((t) => t.name === name);
+
+      if (tunable && (value == null || value === '')) {
+        payload[name] = null;
+      }
+    });
+
+    dispatch(saveOptimizeSettings(payload));
+  }, [pendingChanges, tunables, dispatch]);
+
+  const handleRefreshStatusPress = useCallback(() => {
+    refetchStatus();
+  }, [refetchStatus]);
+
+  useEffect(() => {
+    dispatch(fetchOptimizeSettings());
+
+    return () => {
+      dispatch(clearPendingChanges({ section: `settings.${SECTION}` }));
+    };
+  }, [dispatch]);
+
+  useEffect(() => {
+    if (wasSaving && !isSaving && !saveError) {
+      refetchStatus();
+    }
+  }, [isSaving, wasSaving, saveError, refetchStatus]);
+
+  const renderField = (tunable: OptimizeSettingInfo) => {
+    const setting = (settings as Record<string, unknown>)[tunable.name] as
+      | Pending<OptimizeValue>
+      | undefined;
+
+    return (
+      <OptimizeField
+        key={tunable.name}
+        tunable={tunable}
+        setting={setting}
+        onInputChange={handleInputChange}
+      />
+    );
+  };
+
+  return (
+    <PageContent title="Optimize Settings">
+      <SettingsToolbar
+        hasPendingChanges={hasPendingChanges}
+        isSaving={isSaving}
+        onSavePress={handleSavePress}
+      />
+
+      <PageContentBody>
+        {isFetching && !isPopulated ? <LoadingIndicator /> : null}
+
+        {!isFetching && error ? (
+          <Alert kind={kinds.DANGER}>
+            Unable to load the Optimize settings.
+          </Alert>
+        ) : null}
+
+        {hasSettings && isPopulated && !error ? (
+          <Form
+            id="optimizeSettings"
+            validationErrors={validationErrors}
+            validationWarnings={validationWarnings}
+          >
+            <Alert kind={kinds.INFO}>
+              Settings of the optimizations built into this image. Changes apply
+              as soon as you save, without a restart. A value set by an
+              environment variable on the container is shown read-only.
+            </Alert>
+
+            <FieldSet legend="Optimize">
+              {mainTunables.map(renderField)}
+            </FieldSet>
+
+            <FieldSet legend="Advanced tuning">
+              <Alert kind={kinds.WARNING}>
+                These control internal caches and safety limits. The defaults
+                are tested; changing them can use more memory, hit download
+                hosts faster, or make imports slower. Use Reset to default if
+                unsure.
+              </Alert>
+
+              {advancedSections.map(([section, items]) => (
+                <div key={section}>
+                  <div className={styles.subheading}>{section}</div>
+                  {items.map(renderField)}
+                </div>
+              ))}
+            </FieldSet>
+
+            <FieldSet legend="All optimization settings">
+              <OptimizeSettingsList tunables={tunables} />
+            </FieldSet>
+
+            <FieldSet legend="Status">
+              <OptimizeStatusSection
+                status={status}
+                isFetching={isFetchingStatus}
+                hasError={hasStatusError}
+                onRefreshPress={handleRefreshStatusPress}
+              />
+            </FieldSet>
+          </Form>
+        ) : null}
+      </PageContentBody>
+    </PageContent>
+  );
+}
+
+export default OptimizeSettings;
