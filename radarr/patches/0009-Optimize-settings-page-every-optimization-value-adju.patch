+using NzbDrone.Core.Optimize;
+using Radarr.Http.REST;
+
+namespace Radarr.Api.V3.Config
+{
+    // Values of the Optimize settings page. GET returns null for a number or text that is not set anywhere (it follows
+    // the default). PUT changes only the values present in the request body, as in the Sonarr image: a value left out
+    // keeps its saved value, an explicit null resets it to the default (its saved value is cleared, the source becomes
+    // "default"); sending the default value does the same. Numbers are long so an out-of-range number gets the normal
+    // field error instead of a JSON error. Tunables carries, for every tunable value of the optimization patches (also
+    // the read-only ones), its effective value, default, bounds, source and whether an environment variable locks it;
+    // it is ignored on PUT, as are values whose environment variable is set.
+    public class OptimizeConfigResource : RestResource
+    {
+        // Names of the values present in the request body (the JSON reader calls a setter only for a property it
+        // finds). PUT changes only those: a value left out keeps what is saved, an explicit null resets it.
+        private readonly HashSet<string> _assigned = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        private long? _indexerRateLimitMs;
+        private string _cacheHitHeader;
+        private string _cacheHitValue;
+        private long? _ffprobeTimeoutMinutes;
+        private long? _grabSpacingMs;
+        private long? _customFormatCacheCapacity;
+        private long? _customFormatCacheExpiryMinutes;
+        private long? _customFormatCacheMaxInputChars;
+        private bool? _decisionBatchMemo;
+        private bool? _releaseProfileCache;
+        private long? _ffprobeCacheEntries;
+        private long? _ffprobeCacheMaxMegabytes;
+        private long? _ffprobeCacheMaxEntryKilobytes;
+        private long? _ffprobeCacheFailureMinutes;
+        private long? _ffprobeCacheIdleMinutes;
+        private long? _ffprobeCacheSettleSeconds;
+        private long? _ffprobeCacheUnsettledSeconds;
+        private long? _ffprobeCacheSweepSeconds;
+
+        public long? IndexerRateLimitMs
+        {
+            get => _indexerRateLimitMs;
+            set => Set(ref _indexerRateLimitMs, value);
+        }
+
+        public string CacheHitHeader
+        {
+            get => _cacheHitHeader;
+            set => Set(ref _cacheHitHeader, value);
+        }
+
+        public string CacheHitValue
+        {
+            get => _cacheHitValue;
+            set => Set(ref _cacheHitValue, value);
+        }
+
+        public long? FfprobeTimeoutMinutes
+        {
+            get => _ffprobeTimeoutMinutes;
+            set => Set(ref _ffprobeTimeoutMinutes, value);
+        }
+
