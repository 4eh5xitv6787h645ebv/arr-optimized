+            var type = typeof(OptimizeTunables).Assembly.GetType("NzbDrone.Core.Housekeeping.HousekeepingCommand");
+            const BindingFlags flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static;
+            var field = type?.GetField("MaxDeferral", flags);
+            var value = field != null ? field.GetValue(null) : type?.GetProperty("MaxDeferral", flags)?.GetValue(null);
+
+            return value is TimeSpan span ? span : null;
+        }
+    }
+}
