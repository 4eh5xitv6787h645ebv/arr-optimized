+import {
+  OptimizeSettingInfo,
+  OptimizeValue,
+} from 'typings/Settings/OptimizeSettings';
+
+export function formatNumber(value: number) {
+  return value.toLocaleString('en-US');
+}
+
+const singularUnits: Record<string, string> = {
+  minutes: 'minute',
+  seconds: 'second',
+  files: 'file',
+  entries: 'entry',
+  characters: 'character',
+};
+
+export function formatUnit(unit: string, value: number) {
+  return value === 1 && singularUnits[unit] ? singularUnits[unit] : unit;
+}
+
+function formatOptimizeValue(
+  tunable: Pick<OptimizeSettingInfo, 'kind' | 'unit' | 'name'>,
+  value: OptimizeValue | undefined
+) {
+  if (value == null) {
+    return '-';
+  }
+
+  if (typeof value === 'boolean') {
+    return value ? 'On' : 'Off';
+  }
+
+  if (typeof value === 'number') {
+    return tunable.unit
+      ? `${formatNumber(value)} ${formatUnit(tunable.unit, value)}`
+      : formatNumber(value);
+  }
+
+  if (value === '') {
+    return tunable.name === 'cacheHitHeader' ? 'Off (empty)' : '(empty)';
+  }
+
+  return value;
+}
+
+export function isRiskyValue(
+  tunable: OptimizeSettingInfo,
+  value: OptimizeValue | undefined
+) {
+  if (!tunable.warning || value == null) {
+    return false;
+  }
+
+  if (typeof value === 'boolean') {
+    return value !== tunable.defaultValue;
+  }
+
+  if (typeof value === 'number') {
+    return (
+      (tunable.warnBelow != null && value < tunable.warnBelow) ||
+      (tunable.warnAbove != null && value > tunable.warnAbove)
+    );
+  }
+
+  return false;
+}
+
+export default formatOptimizeValue;
