+    public static class OptimizeConfigResourceMapper
+    {
+        private static readonly PropertyInfo[] ValueProperties = typeof(OptimizeConfigResource)
+            .GetProperties(BindingFlags.Instance | BindingFlags.Public)
+            .Where(p => OptimizeTunables.Get(p.Name) is { Editable: true })
+            .ToArray();
+
+        public static IEnumerable<string> ValuePropertyNames => ValueProperties.Select(p => p.Name);
+
+        public static OptimizeConfigResource ToResource(OptimizeSettings settings, List<OptimizeSettingInfo> tunables)
+        {
+            var resource = new OptimizeConfigResource { Id = 1, Tunables = tunables };
+
+            foreach (var property in ValueProperties)
+            {
+                var tunable = OptimizeTunables.Get(property.Name);
+                var effective = settings[tunable.Name];
+
+                var value = effective.Source == OptimizeValueSource.Default && tunable.Kind != OptimizeValueKind.Boolean
+                    ? null
+                    : effective.Value;
+
+                property.SetValue(resource, value);
+            }
+
+            return resource;
+        }
+
+        // Values by tunable name, for IOptimizeSettingsService.Save and Validate: the values present in the request
+        // (see OptimizeConfigResource), an explicit null included (it resets the value).
+        public static Dictionary<string, object> ToValues(this OptimizeConfigResource resource)
+        {
+            return ValueProperties
+                .Where(p => resource.IsAssigned(p.Name))
+                .ToDictionary(p => OptimizeTunables.Get(p.Name).Name, p => p.GetValue(resource), StringComparer.OrdinalIgnoreCase);
+        }
+    }
