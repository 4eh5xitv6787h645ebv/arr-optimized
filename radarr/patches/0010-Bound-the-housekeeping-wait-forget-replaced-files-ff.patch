index 937bf3794..2da4aea0f 100644
--- a/src/NzbDrone.Core/Housekeeping/HousekeepingCommand.cs
+++ b/src/NzbDrone.Core/Housekeeping/HousekeepingCommand.cs
@@ -1,9 +1,16 @@
-﻿using NzbDrone.Core.Messaging.Commands;
+﻿using System;
+using NzbDrone.Core.Messaging.Commands;
 
 namespace NzbDrone.Core.Housekeeping
 {
     public class HousekeepingCommand : Command
     {
+        // Housekeeping waits until no other command runs, so it can VACUUM alone. After waiting this long it starts
+        // anyway and runs alongside other commands, as on stock (CommandQueue.TryGet).
+        public const int MaxDeferralMinutes = 30;
+
+        public static readonly TimeSpan MaxDeferral = TimeSpan.FromMinutes(MaxDeferralMinutes);
+
         public override bool IsExclusive => true;
     }
 }
