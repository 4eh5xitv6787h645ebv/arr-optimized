 namespace NzbDrone.Core.Messaging.Commands
 {
     public class CommandQueue : IEnumerable
     {
+        private static readonly TimeSpan MinimumDeferralWait = TimeSpan.FromSeconds(1);
+
+        private static readonly Logger Logger = NzbDroneLogger.GetLogger(typeof(CommandQueue));
+
         private readonly object _mutex = new object();
         private readonly List<CommandModel> _items;
 
+        // Housekeeping commands that started after waiting HousekeepingCommand.MaxDeferral while other commands ran.
+        // They run like stock: not exclusive.
+        private readonly HashSet<CommandModel> _startedWithoutExclusivity = new HashSet<CommandModel>(ReferenceEqualityComparer.Instance);
+
+        // When a queued housekeeping is held back only because other commands run, the time its wait runs out, so a
+        // waiting consumer re-evaluates the queue then even if nothing else wakes it.
+        private DateTime? _housekeepingDeferredUntil;
+
+        // Queued housekeeping commands whose wait has been logged, so it is logged once per command.
+        private readonly HashSet<CommandModel> _deferralLogged = new HashSet<CommandModel>(ReferenceEqualityComparer.Instance);
+
         public CommandQueue()
         {
             _items = new List<CommandModel>();
@@ -124,7 +141,16 @@ public IEnumerable<CommandModel> GetConsumingEnumerable(CancellationToken cancel
 
                     if (!TryGet(out command))
                     {
-                        Monitor.Wait(_mutex);
+                        if (_housekeepingDeferredUntil.HasValue)
+                        {
+                            var wait = _housekeepingDeferredUntil.Value - DateTime.UtcNow;
+                            Monitor.Wait(_mutex, wait > MinimumDeferralWait ? wait : MinimumDeferralWait);
+                        }
+                        else
+                        {
+                            Monitor.Wait(_mutex);
+                        }
+
                         continue;
                     }
                 }
@@ -152,6 +178,15 @@ public bool TryGet(out CommandModel item)
 
             lock (_mutex)
             {
+                var now = DateTime.UtcNow;
+                _housekeepingDeferredUntil = null;
+                _startedWithoutExclusivity.RemoveWhere(c => c.Status != CommandStatus.Started);
+
+                if (_deferralLogged.Count > 0)
+                {
+                    _deferralLogged.RemoveWhere(c => c.Status != CommandStatus.Queued || !_items.Contains(c));
+                }
+
                 if (_items.Count == 0)
                 {
                     rval = false;
@@ -179,14 +214,31 @@ public bool TryGet(out CommandModel item)
 
                     if (startedCommands.Any(x => x.Body.IsLongRunning))
                     {
-                        queuedCommands = queuedCommands.Where(c => !c.Body.IsExclusive);
+                        queuedCommands = queuedCommands.Where(c => !IsExclusiveWhileOthersRun(c, now));
                     }
 
                     // Housekeeping is exclusive, but while it waits for running commands to finish it must not
                     // hold back the commands queued after it (e.g. RSS Sync), so it only starts once nothing is running.
+                    // After waiting HousekeepingCommand.MaxDeferral it falls back to stock: it starts while others run
+                    // and is not exclusive, so a stuck or very long command cannot keep housekeeping from running.
                     if (startedCommands.Any())
                     {
-                        queuedCommands = queuedCommands.Where(c => !(c.Body is HousekeepingCommand));
+                        var deferred = _items.Where(c => c.Status == CommandStatus.Queued && c.Body is HousekeepingCommand && !IsOverdueHousekeeping(c, now)).ToList();
+
+                        if (deferred.Any())
+                        {
+                            _housekeepingDeferredUntil = deferred.Min(c => c.QueuedAt) + HousekeepingCommand.MaxDeferral;
+
+                            foreach (var command in deferred.Where(c => _deferralLogged.Add(c)))
+                            {
+                                Logger.Debug("Housekeeping (command {0}) waits for running commands to finish ({1}). It starts anyway {2} minutes after it was queued.",
+                                    command.Id,
+                                    string.Join(", ", startedCommands.Select(c => c.Name)),
+                                    HousekeepingCommand.MaxDeferralMinutes);
+                            }
+
+                            queuedCommands = queuedCommands.Where(c => !deferred.Contains(c));
+                        }
                     }
 
                     var localItem = queuedCommands.OrderByDescending(c => c.Priority)
@@ -200,14 +252,14 @@ public bool TryGet(out CommandModel item)
                     }
 
                     // If any executing command is exclusive don't want return another command until it completes.
-                    else if (startedCommands.Any(c => c.Body.IsExclusive))
+                    else if (startedCommands.Any(c => c.Body.IsExclusive && !_startedWithoutExclusivity.Contains(c)))
                     {
                         rval = false;
                     }
 
                     // If the next command to execute is exclusive wait for executing commands to complete.
                     // This will prevent other tasks from starting so the exclusive task executes in the order it should.
-                    else if (localItem.Body.IsExclusive && startedCommands.Any())
+                    else if (startedCommands.Any() && IsExclusiveWhileOthersRun(localItem, now))
                     {
                         rval = false;
                     }
@@ -215,6 +267,16 @@ public bool TryGet(out CommandModel item)
                     // A command ready to execute
                     else
                     {
+                        if (localItem.Body.IsExclusive && startedCommands.Any())
+                        {
+                            // Only an overdue housekeeping gets here.
+                            _startedWithoutExclusivity.Add(localItem);
+
+                            Logger.Info("Housekeeping has waited {0} minutes for running commands to finish ({1}). Starting it alongside them, not exclusive.",
+                                HousekeepingCommand.MaxDeferralMinutes,
+                                string.Join(", ", startedCommands.Select(c => c.Name)));
+                        }
+
                         localItem.StartedAt = DateTime.UtcNow;
                         localItem.Status = CommandStatus.Started;
 
@@ -225,5 +287,17 @@ public bool TryGet(out CommandModel item)
 
             return rval;
         }
+
+        // Whether a queued command must wait for running commands to finish because it is exclusive. A housekeeping
+        // that has waited HousekeepingCommand.MaxDeferral does not: it starts alongside them, as on stock.
+        private static bool IsExclusiveWhileOthersRun(CommandModel command, DateTime now)
+        {
+            return command.Body.IsExclusive && !IsOverdueHousekeeping(command, now);
+        }
+
+        private static bool IsOverdueHousekeeping(CommandModel command, DateTime now)
+        {
+            return command.Body is HousekeepingCommand && now - command.QueuedAt >= HousekeepingCommand.MaxDeferral;
+        }
     }
 }
