+        // The shared cached list; never handed out. Cache off (Optimize settings): read every time, as on stock.
+        // Every write still clears the cached list, so it is never out of date when the cache is turned on again.
+        private List<ReleaseProfile> Cached()
+        {
+            if (!OptimizeSettings.Current.ReleaseProfileCache)
+            {
+                return _repo.All().ToList();
+            }
+
+            lock (_profilesLock)
+            {
+                return _profiles ??= _repo.All().ToList();
+            }
+        }
+
+        private static bool MatchesTags(ReleaseProfile profile, HashSet<int> tagIds)
+        {
+            return profile.Tags.Intersect(tagIds).Any() || profile.Tags.Empty();
+        }
+
+        // Every ReleaseProfile member is a value or a string except Required, Ignored and Tags, which are copied.
+        internal static ReleaseProfile Copy(ReleaseProfile profile)
+        {
+            return new ReleaseProfile
+            {
+                Id = profile.Id,
+                Name = profile.Name,
+                Enabled = profile.Enabled,
+                Required = profile.Required?.ToList(),
+                Ignored = profile.Ignored?.ToList(),
+                IndexerId = profile.IndexerId,
+                Tags = profile.Tags == null ? null : new HashSet<int>(profile.Tags, profile.Tags.Comparer)
+            };
