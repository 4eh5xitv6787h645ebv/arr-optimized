diff --git a/src/NzbDrone.Core/DecisionEngine/DecisionScope.cs b/src/NzbDrone.Core/DecisionEngine/DecisionScope.cs
new file mode 100644
index 0000000..b812e31
--- /dev/null
+++ b/src/NzbDrone.Core/DecisionEngine/DecisionScope.cs
@@ -0,0 +1,90 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+
+namespace NzbDrone.Core.DecisionEngine
+{
+    // Read-through memo for one synchronous batch of download decisions (one GetRssDecision or
+    // GetSearchDecision call). Specifications re-read the same rows for every release in a batch:
+    // indexer definition, release profiles, episode history, episodes in a file and the series'
+    // blocklist. Inside a batch they are read once. Nothing is kept after the batch; outside a batch
+    // the loader runs directly. Only read-only consumers use this.
+    //
+    // Exactness rules:
+    // - The kind is the name of the table the loader reads. Every write to that table through
+    //   BasicRepository (and the raw-SQL housekeepers) calls TableChanged after it commits, so a row
+    //   written while a batch runs (e.g. by Completed Download Handling on another thread) is seen by
+    //   the next lookup, as it would be without the memo. (EpisodeRepository's raw-SQL updates of
+    //   Episodes.Monitored are not reported: the Episodes memo's only consumer reads episode ids.)
+    // - null results and exceptions are never stored: the loader runs again next time, so a missing
+    //   row behaves exactly as before (IIndexerFactory.Find returns null where Get throws, and both
+    //   read the same key).
+    internal sealed class DecisionScope : IDisposable
+    {
+        private static readonly ConcurrentDictionary<string, long> TableVersions = new ConcurrentDictionary<string, long>(StringComparer.Ordinal);
+
+        [ThreadStatic]
+        private static DecisionScope _current;
+
+        private readonly Dictionary<(string Kind, int Id), (long Version, object Value)> _values;
+
+        private DecisionScope(bool owner)
+        {
+            _values = owner ? new Dictionary<(string Kind, int Id), (long Version, object Value)>() : null;
+        }
+
+        public static bool Active => _current != null;
+
+        public static DecisionScope Begin()
+        {
+            if (_current != null)
+            {
+                return new DecisionScope(false);
+            }
+
+            _current = new DecisionScope(true);
+            return _current;
+        }
+
+        // Call after a write to the table has committed.
+        public static void TableChanged(string table)
+        {
+            TableVersions.AddOrUpdate(table, 1, static (_, version) => version + 1);
+        }
+
+        public static T Memo<T>(string kind, int id, Func<T> load)
+            where T : class
+        {
+            var scope = _current;
+            if (scope == null)
+            {
+                return load();
+            }
+
+            // Read the version before loading: a write that commits during the load leaves the stored
+            // version behind, so the next lookup loads again.
+            TableVersions.TryGetValue(kind, out var version);
+
+            if (scope._values.TryGetValue((kind, id), out var entry) && entry.Version == version)
+            {
+                return (T)entry.Value;
+            }
+
+            var result = load();
+            if (result != null)
+            {
+                scope._values[(kind, id)] = (version, result);
+            }
+
+            return result;
+        }
+
+        public void Dispose()
+        {
+            if (_values != null && ReferenceEquals(_current, this))
+            {
+                _current = null;
+            }
+        }
+    }
+}
