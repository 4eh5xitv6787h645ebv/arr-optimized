diff --git a/src/NzbDrone.Core/Blocklisting/SqliteLike.cs b/src/NzbDrone.Core/Blocklisting/SqliteLike.cs
new file mode 100644
index 0000000..279689c
--- /dev/null
+++ b/src/NzbDrone.Core/Blocklisting/SqliteLike.cs
@@ -0,0 +1,95 @@
+namespace NzbDrone.Core.Blocklisting
+{
+    // Exact in-memory evaluation of SQLite's "value LIKE '%' || needle || '%'" as generated for
+    // string.Contains by WhereBuilderSqlite: no ESCAPE clause, case_sensitive_like off, no ICU.
+    // '%' matches any sequence, '_' exactly one character, and only ASCII letters compare
+    // case-insensitively; every other character compares by code point, except that U+FFFE and
+    // U+FFFF compare equal to U+FFFD (see Fold).
+    // Returns null when exact emulation is not guaranteed; the caller must then ask the database.
+    internal static class SqliteLike
+    {
+        private const int MaxPatternBytes = 50000; // SQLITE_MAX_LIKE_PATTERN_LENGTH
+
+        public static bool? ContainsLike(string value, string needle)
+        {
+            if (needle == null || !Plain(needle) || (needle.Length * 3) + 2 > MaxPatternBytes)
+            {
+                return null;
+            }
+
+            if (value == null)
+            {
+                return false; // NULL LIKE pattern is NULL, so the row is not selected.
+            }
+
+            if (!Plain(value))
+            {
+                return null;
+            }
+
+            var pattern = "%" + needle + "%";
+            return Match(pattern, value);
+        }
+
+        // Surrogates and NUL are left to SQLite (UTF-8 conversion and C-string semantics).
+        private static bool Plain(string s)
+        {
+            foreach (var c in s)
+            {
+                if (c == '\0' || char.IsSurrogate(c))
+                {
+                    return false;
+                }
+            }
+
+            return true;
+        }
+
+        // patternCompare reads characters with sqlite3Utf8Read, which returns U+FFFD for the
+        // noncharacters U+FFFE and U+FFFF (surrogates, the other remapped input, never get here).
+        private static char Fold(char c)
+        {
+            if (c >= 'A' && c <= 'Z')
+            {
+                return (char)(c + 32);
+            }
+
+            return c >= '\uFFFE' ? '\uFFFD' : c;
+        }
+
+        // Iterative wildcard match with single-star backtracking; exact for '%' and '_' patterns.
+        private static bool Match(string pattern, string text)
+        {
+            int p = 0, t = 0, star = -1, mark = 0;
+            while (t < text.Length)
+            {
+                if (p < pattern.Length && pattern[p] == '%')
+                {
+                    star = p++;
+                    mark = t;
+                }
+                else if (p < pattern.Length && (pattern[p] == '_' || Fold(pattern[p]) == Fold(text[t])))
+                {
+                    p++;
+                    t++;
+                }
+                else if (star >= 0)
+                {
+                    p = star + 1;
+                    t = ++mark;
+                }
+                else
+                {
+                    return false;
+                }
+            }
+
+            while (p < pattern.Length && pattern[p] == '%')
+            {
+                p++;
+            }
+
+            return p == pattern.Length;
+        }
+    }
+}
