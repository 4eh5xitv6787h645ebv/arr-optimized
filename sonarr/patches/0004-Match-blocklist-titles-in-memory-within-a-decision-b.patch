+        // Same rows as BlocklistRepository.BlocklistedByTitle. Inside a decision batch the series' rows are read
+        // once and SQLite's LIKE '%' || title || '%' is evaluated in memory with SQLite's exact rules.
+        private List<Blocklist> BlocklistedByTitle(int seriesId, string title)
+        {
+            if (DecisionScope.Active)
+            {
+                var rows = DecisionScope.Memo("Blocklist", seriesId, () => _blocklistRepository.BlocklistedBySeriesForTitleMatch(seriesId));
+                if (rows != null)
+                {
+                    var matches = new List<Blocklist>();
+                    foreach (var row in rows)
+                    {
+                        var like = SqliteLike.ContainsLike(row.SourceTitle, title);
+                        if (like == null)
+                        {
+                            return _blocklistRepository.BlocklistedByTitle(seriesId, title);
+                        }
+
+                        if (like.Value)
+                        {
+                            matches.Add(row);
+                        }
+                    }
+
+                    return matches;
+                }
+            }
+
+            return _blocklistRepository.BlocklistedByTitle(seriesId, title);
+        }
