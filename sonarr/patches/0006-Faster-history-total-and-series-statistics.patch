From: arr-optimized <arr-optimized@users.noreply.github.com>
Date: Wed, 25 Nov 2026 12:00:00 +0000
Subject: [PATCH 06/10] Faster history total and series statistics

- Unfiltered history pages on SQLite count all rows minus orphaned rows
  instead of joining Series and Episodes for the total. The total is the
  same as stock, including while orphaned rows wait for housekeeping.
  Filtered pages and PostgreSQL keep the stock count.
- Series statistics join file statistics through a dictionary instead of a
  linear search per season.
---
 .../History/HistoryRepository.cs              | 30 +++++++++++++++++--
 .../SeriesStats/SeriesStatisticsRepository.cs |  5 +++-
 2 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/src/NzbDrone.Core/History/HistoryRepository.cs b/src/NzbDrone.Core/History/HistoryRepository.cs
index 72e78a245c..17dc1b0285 100644
--- a/src/NzbDrone.Core/History/HistoryRepository.cs
+++ b/src/NzbDrone.Core/History/HistoryRepository.cs
@@ -145,8 +145,20 @@ public PagingSpec<EpisodeHistory> GetPaged(PagingSpec<EpisodeHistory> pagingSpec
 
             pagingSpec.Records = GetPagedRecords(PagedBuilder(languages, qualities, sortingByQuality), pagingSpec, PagedQuery, customSortExpression);
 
-            var countTemplate = $"SELECT COUNT(*) FROM (SELECT /**select**/ FROM \"{TableMapping.Mapper.TableNameMapping(typeof(EpisodeHistory))}\" /**join**/ /**innerjoin**/ /**leftjoin**/ /**where**/ /**groupby**/ /**having**/) AS \"Inner\"";
-            pagingSpec.TotalRecords = GetPagedRecordCount(PagedBuilder(languages, qualities, sortingByQuality).Select(typeof(EpisodeHistory)), pagingSpec, countTemplate);
+            if (_database.DatabaseType == DatabaseType.SQLite && pagingSpec.FilterExpressions.Count == 0 && languages is not { Length: > 0 } && qualities is not { Length: > 0 })
+            {
+                // Unfiltered page on SQLite: the joined count reads every History row. The inner joins on Series and
+                // Episodes drop a row exactly when its series or its episode no longer exists (orphans wait for
+                // housekeeping), and the quality ranks LEFT JOIN is on a unique key, so the same total is all rows minus
+                // the orphans. PostgreSQL keeps stock's joined count: it hash-joins that quickly, while it can plan the
+                // NOT IN subqueries below as a rescan of Episodes for every History row on large libraries.
+                pagingSpec.TotalRecords = GetPagedRecordCount(Builder(), pagingSpec, UnfilteredCountTemplate());
+            }
+            else
+            {
+                var countTemplate = $"SELECT COUNT(*) FROM (SELECT /**select**/ FROM \"{TableMapping.Mapper.TableNameMapping(typeof(EpisodeHistory))}\" /**join**/ /**innerjoin**/ /**leftjoin**/ /**where**/ /**groupby**/ /**having**/) AS \"Inner\"";
+                pagingSpec.TotalRecords = GetPagedRecordCount(PagedBuilder(languages, qualities, sortingByQuality).Select(typeof(EpisodeHistory)), pagingSpec, countTemplate);
+            }
 
             return pagingSpec;
         }
@@ -182,6 +194,20 @@ private SqlBuilder PagedBuilder(int[] languages, int[] qualities, bool joinQuali
             return builder;
         }
 
+        private static string UnfilteredCountTemplate()
+        {
+            var history = TableMapping.Mapper.TableNameMapping(typeof(EpisodeHistory));
+            var series = TableMapping.Mapper.TableNameMapping(typeof(Series));
+            var episodes = TableMapping.Mapper.TableNameMapping(typeof(Episode));
+            var episodeGone = $"SELECT \"h2\".\"Id\" FROM \"{history}\" AS \"h2\" WHERE \"h2\".\"EpisodeId\" NOT IN (SELECT \"Id\" FROM \"{episodes}\")";
+
+            // All rows - rows whose episode is gone - rows whose series is gone but whose episode is not.
+            // Each count scans one History index only (no UNION, which SQLite answers by scanning the table).
+            return $"SELECT (SELECT COUNT(*) FROM \"{history}\") - (SELECT COUNT(*) FROM ({episodeGone}) AS \"e\") - " +
+                   $"(SELECT COUNT(*) FROM \"{history}\" WHERE \"{history}\".\"SeriesId\" NOT IN (SELECT \"Id\" FROM \"{series}\") " +
+                   $"AND \"{history}\".\"Id\" NOT IN ({episodeGone}))";
+        }
+
         protected override IEnumerable<EpisodeHistory> PagedQuery(SqlBuilder builder) =>
             _database.QueryJoined<EpisodeHistory, Series, Episode>(builder, (history, series, episode) =>
             {
diff --git a/src/NzbDrone.Core/SeriesStats/SeriesStatisticsRepository.cs b/src/NzbDrone.Core/SeriesStats/SeriesStatisticsRepository.cs
index e5dc22c22d..dd6c8a5018 100644
--- a/src/NzbDrone.Core/SeriesStats/SeriesStatisticsRepository.cs
+++ b/src/NzbDrone.Core/SeriesStats/SeriesStatisticsRepository.cs
@@ -43,9 +43,12 @@ public List<SeasonStatistics> SeriesStatistics(int seriesId)
 
         private List<SeasonStatistics> MapResults(List<SeasonStatistics> episodesResult, List<SeasonStatistics> filesResult)
         {
+            // Both queries group by (SeriesId, SeasonNumber), so each key has at most one files row.
+            var filesBySeason = filesResult.ToDictionary(f => (f.SeriesId, f.SeasonNumber));
+
             episodesResult.ForEach(e =>
             {
-                var file = filesResult.SingleOrDefault(f => f.SeriesId == e.SeriesId && f.SeasonNumber == e.SeasonNumber);
+                filesBySeason.TryGetValue((e.SeriesId, e.SeasonNumber), out var file);
 
                 e.SizeOnDisk = file?.SizeOnDisk ?? 0;
                 e.ReleaseGroupsString = file?.ReleaseGroupsString;
