+++ b/frontend/src/Settings/Optimize/useOptimizeSettings.ts
@@ -0,0 +1,205 @@
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useCallback, useMemo } from 'react';
+import { usePendingChangesStore } from 'Helpers/Hooks/usePendingChangesStore';
+import fetchJson, { ApiError, urlBase } from 'Utilities/Fetch/fetchJson';
+import selectSettings from 'Utilities/selectSettings';
+
+// The Optimize page lives in the v3 API (config/optimize), like the other
+// config endpoints of the v3 API; the rest of this UI talks to v5.
+const PATH = `${urlBase}/api/v3/config/optimize`;
+const STATUS_PATH = `${PATH}/status`;
+
+const headers = () => ({
+  'X-Api-Key': window.Sonarr.apiKey,
+  'X-Sonarr-Client': 'Sonarr',
+});
+
+export type OptimizeValue = number | string | boolean | null;
+
+export interface OptimizeSettingInfo {
+  name: string;
+  label: string;
+  section: string;
+  description: string;
+  unit: string | null;
+  type: 'integer' | 'text' | 'boolean';
+  editable: boolean;
+  advanced: boolean;
+  locked: boolean;
+  value: OptimizeValue;
+  defaultValue: OptimizeValue;
+  savedValue: OptimizeValue;
+  source: 'default' | 'saved' | 'environment' | 'derived' | 'fixed';
+  howToChange: string;
+  environmentVariable: string | null;
+  environmentValue: string | null;
+  environmentError: string | null;
+  savedError: string | null;
+  min: number | null;
+  max: number | null;
+  environmentMax: number | null;
+  warning: string | null;
+  warnBelow: number | null;
+  warnAbove: number | null;
+  warnWhen: boolean | null;
+  currentValueRisky: boolean;
+  constants: string[];
+}
+
+export interface OptimizeSettingsModel {
+  id: number;
+  indexerRateLimitMs: number | null;
+  cacheHitHeader: string | null;
+  cacheHitValue: string | null;
+  ffprobeTimeoutMinutes: number | null;
+  grabSpacingMs: number | null;
+  cfCacheCapacity: number | null;
+  cfCacheLifetimeMinutes: number | null;
+  cfCacheMaxKeyChars: number | null;
+  cfCacheSweepSeconds: number | null;
+  decisionMemoEnabled: boolean | null;
+  ffprobeCacheCapacity: number | null;
+  ffprobeCacheMaxMb: number | null;
+  ffprobeCacheMaxEntryKb: number | null;
+  ffprobeCacheIdleMinutes: number | null;
+  ffprobeCacheFailureMinutes: number | null;
+  ffprobeCacheSettleSeconds: number | null;
+  ffprobeCacheUnsettledSeconds: number | null;
+  ffprobeCacheSweepSeconds: number | null;
+  settings: OptimizeSettingInfo[];
+}
+
+export interface OptimizeStatusItem {
+  name: string;
+  description: string;
+  state: string;
+  active: boolean;
+}
+
+export interface OptimizeCounter {
+  name: string;
+  label: string;
+  group: string;
+  value: number;
+  unit: string | null;
+  description: string;
+}
+
+export interface OptimizeStatus {
+  startedAt: string;
+  optimizations: OptimizeStatusItem[];
+  counters: OptimizeCounter[];
+}
+
+export const useOptimizeStatus = () => {
+  return useQuery<OptimizeStatus, ApiError>({
+    queryKey: [STATUS_PATH],
+    queryFn: ({ signal }) =>
+      fetchJson<OptimizeStatus, unknown>({
+        path: STATUS_PATH,
+        headers: headers(),
+        signal,
+      }),
+    staleTime: 0,
+  });
+};
+
+export const useManageOptimizeSettings = () => {
+  const queryClient = useQueryClient();
+
+  const query = useQuery<OptimizeSettingsModel, ApiError>({
+    queryKey: [PATH],
+    queryFn: ({ signal }) =>
+      fetchJson<OptimizeSettingsModel, unknown>({
+        path: PATH,
+        headers: headers(),
+        signal,
+      }),
+  });
+
+  const data = useMemo(
+    () => query.data ?? ({} as OptimizeSettingsModel),
+    [query.data]
+  );
+
+  const { pendingChanges, setPendingChange, clearPendingChanges } =
+    usePendingChangesStore<OptimizeSettingsModel>({});
+
+  const mutation = useMutation<
+    OptimizeSettingsModel,
+    ApiError,
+    OptimizeSettingsModel
+  >({
+    mutationFn: (body) =>
+      fetchJson<OptimizeSettingsModel, OptimizeSettingsModel>({
+        path: PATH,
+        method: 'PUT',
+        headers: headers(),
+        body,
+      }),
+    onSuccess: (updated) => {
+      queryClient.setQueryData<OptimizeSettingsModel>([PATH], updated);
+      queryClient.invalidateQueries({ queryKey: [STATUS_PATH] });
+      clearPendingChanges();
+    },
+  });
+
+  const changedValues = useMemo(() => {
+    const changed: Partial<OptimizeSettingsModel> = {};
+
+    (Object.keys(pendingChanges) as (keyof OptimizeSettingsModel)[]).forEach(
+      (key) => {
+        // GET leaves out values that are not saved (undefined) while an
+        // emptied field is null: both mean "not saved", so neither is a change.
+        if ((data[key] ?? null) !== (pendingChanges[key] ?? null)) {
+          // @ts-expect-error - key and value come from the same model
+          changed[key] = pendingChanges[key];
+        }
+      }
+    );
+
+    return changed;
+  }, [data, pendingChanges]);
+
+  const selected = useMemo(() => {
+    return selectSettings<OptimizeSettingsModel>(
+      data,
+      changedValues,
+      mutation.error
+    );
+  }, [data, changedValues, mutation.error]);
+
+  const saveSettings = useCallback(() => {
+    // The settings list is read-only; the API ignores it.
+    const { settings: _settings, ...values } = data;
+
+    mutation.mutate({
+      ...values,
+      ...changedValues,
+      id: data.id ?? 1,
+    } as OptimizeSettingsModel);
+  }, [data, changedValues, mutation]);
+
+  const updateSetting = useCallback(
+    <K extends keyof OptimizeSettingsModel>(
+      key: K,
+      value: OptimizeSettingsModel[K]
+    ) => {
+      setPendingChange(key, value);
+    },
+    [setPendingChange]
+  );
+
+  return {
+    ...selected,
+    hasPendingChanges: Object.keys(changedValues).length > 0,
+    infos: data.settings ?? [],
+    updateSetting,
+    saveSettings,
+    isFetching: query.isFetching,
+    isFetched: query.isFetched,
+    isSaving: mutation.isPending,
+    error: query.error,
+    saveError: mutation.error,
+  };
+};
