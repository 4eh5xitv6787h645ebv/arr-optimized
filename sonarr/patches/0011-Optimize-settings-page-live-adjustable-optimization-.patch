+
+        public object Value { get; set; }
+        public object DefaultValue { get; set; }
+        public object SavedValue { get; set; }
+
+        // "default", "saved", "environment" for editable values; "derived" or "fixed" for the others.
+        public string Source { get; set; }
+        public string HowToChange { get; set; }
+
+        public string EnvironmentVariable { get; set; }
+        public string EnvironmentValue { get; set; }
+        public string EnvironmentError { get; set; }
+        public string SavedError { get; set; }
+
+        public long? Min { get; set; }
+        public long? Max { get; set; }
+        public long? EnvironmentMax { get; set; }
+
+        // Risk warning, the condition it applies to, and whether the current value meets it.
+        public string Warning { get; set; }
+        public long? WarnBelow { get; set; }
+        public long? WarnAbove { get; set; }
+        public bool? WarnWhen { get; set; }
+        public bool CurrentValueRisky { get; set; }
+
+        public List<string> Constants { get; set; } = new List<string>();
+    }
+
+    public class OptimizeStatus
+    {
+        public DateTime StartedAt { get; set; }
+        public List<OptimizeStatusItem> Optimizations { get; set; } = new List<OptimizeStatusItem>();
+        public List<OptimizeCounter> Counters { get; set; } = new List<OptimizeCounter>();
+    }
+
+    public class OptimizeStatusItem
+    {
+        public string Name { get; set; }
+        public string Description { get; set; }
+
+        // "on", "off", "default" (always on, nothing to switch) or a short value such as "500 ms".
+        public string State { get; set; }
+        public bool Active { get; set; }
+    }
+
+    public class OptimizeCounter
+    {
+        public string Name { get; set; }
+        public string Label { get; set; }
+        public string Group { get; set; }
+        public long Value { get; set; }
+        public string Unit { get; set; }
+        public string Description { get; set; }
+    }
+
+    public class OptimizeValidationFailure
+    {
+        public OptimizeValidationFailure(string name, string message)
+        {
+            Name = name;
+            Message = message;
+        }
+
+        public string Name { get; }
+        public string Message { get; }
+    }
+}
diff --git a/src/NzbDrone.Core/Optimization/OptimizeSettings.cs b/src/NzbDrone.Core/Optimization/OptimizeSettings.cs
new file mode 100644
index 0000000000..995d7a79e8
--- /dev/null
+++ b/src/NzbDrone.Core/Optimization/OptimizeSettings.cs
@@ -0,0 +1,283 @@
+using System;
+using System.Collections.Generic;
+using System.Threading;
+using NLog;
+using NzbDrone.Common.Instrumentation;
+using NzbDrone.Core.Indexers;
+
+namespace NzbDrone.Core.Optimization
+{
+    public enum OptimizeSettingSource
+    {
+        Default,
+        Saved,
+        Environment
+    }
+
+    // How one value was resolved: a valid environment variable wins, then a valid saved value, then the default.
+    public class OptimizeResolvedValue
+    {
+        public object Value { get; set; }
+        public OptimizeSettingSource Source { get; set; }
+        public string EnvironmentText { get; set; }
+        public string EnvironmentError { get; set; }
+        public object SavedValue { get; set; }
+        public string SavedError { get; set; }
+
+        public bool Locked => Source == OptimizeSettingSource.Environment;
+    }
+
+    // Limits of MediaInfoProbeCache in effect.
+    internal sealed class ProbeCacheLimits
+    {
+        public bool Enabled;
+        public int Capacity;
+        public int EvictionBatch;
+        public long MaxBytes;
+        public long MaxEntryBytes;
+        public long IdleLifetimeMs;
+        public long FailureLifetimeMs;
+        public TimeSpan SettleTime;
+        public long UnsettledLifetimeMs;
+        public long SweepIntervalMs;
+    }
+
+    // The effective optimization settings: one immutable snapshot, swapped as a whole when the settings change.
+    // Hot paths read OptimizeSettings.Current once (a volatile field read) and use its fields; no locks, no database.
+    public sealed class OptimizeSettings
+    {
+        private static readonly object CurrentLock = new object();
+        private static OptimizeSettings _current;
+
+        // Warnings already logged in this process (each invalid value is reported once, not on every save).
+        internal static readonly HashSet<string> Warned = new HashSet<string>();
+
+        private OptimizeSettings()
+        {
+        }
+
+        public int IndexerRateLimitMs { get; private set; }
+        public string CacheHitHeader { get; private set; }
+        public string CacheHitValue { get; private set; }
+        public int FfprobeTimeoutMinutes { get; private set; }
+        public int GrabSpacingMs { get; private set; }
+        public int CfCacheCapacity { get; private set; }
+        public int CfCacheLifetimeMinutes { get; private set; }
+        public int CfCacheMaxKeyChars { get; private set; }
+        public int CfCacheSweepSeconds { get; private set; }
+        public bool DecisionMemoEnabled { get; private set; }
+        public int FfprobeCacheCapacity { get; private set; }
+        public int FfprobeCacheMaxMb { get; private set; }
+        public int FfprobeCacheMaxEntryKb { get; private set; }
+        public int FfprobeCacheIdleMinutes { get; private set; }
+        public int FfprobeCacheFailureMinutes { get; private set; }
+        public int FfprobeCacheSettleSeconds { get; private set; }
+        public int FfprobeCacheUnsettledSeconds { get; private set; }
+        public int FfprobeCacheSweepSeconds { get; private set; }
+
+        public IReadOnlyDictionary<string, OptimizeResolvedValue> Resolved { get; private set; }
+
+        // Derived values used by the hot paths.
+        public IndexerRateLimitOptions RateLimit { get; private set; }
+        public TimeSpan FfprobeTimeout { get; private set; }
+        internal long CfCacheLifetimeMs { get; private set; }
+        internal long CfCacheSweepMs { get; private set; }
+        internal int CfCacheEvictionBatch { get; private set; }
+        internal ProbeCacheLimits ProbeCache { get; private set; }
+
+        // The settings in effect. Until the settings service publishes the saved values (at startup and after every
+        // save), the environment and the defaults apply. Setting null makes the next read resolve the environment
+        // again (used by tests).
+        public static OptimizeSettings Current
+        {
+            get
+            {
+                var current = Volatile.Read(ref _current);
+
+                if (current != null)
+                {
+                    return current;
+                }
+
+                lock (CurrentLock)
+                {
+                    if (_current == null)
+                    {
+                        Volatile.Write(ref _current, Resolve(Environment.GetEnvironmentVariable, _ => null, NzbDroneLogger.GetLogger(typeof(OptimizeSettings)), Warned));
+                    }
+
+                    return _current;
+                }
+            }
+
+            internal set
+            {
+                lock (CurrentLock)
+                {
+                    if (value == null)
+                    {
+                        lock (Warned)
+                        {
+                            Warned.Clear();
+                        }
+                    }
+
+                    Volatile.Write(ref _current, value);
+                }
+            }
+        }
+
+        // The published settings, or null before anything resolved them.
+        internal static OptimizeSettings Published => Volatile.Read(ref _current);
+
+        public static OptimizeSettings Defaults => Resolve(_ => null, _ => null, null);
+
+        // warned: when given, each distinct warning is logged once per set.
+        public static OptimizeSettings Resolve(Func<string, string> getEnvironment, Func<string, string> getSaved, Logger logger, ISet<string> warned = null)
+        {
+            var settings = new OptimizeSettings();
+            var resolved = new Dictionary<string, OptimizeResolvedValue>();
+
+            foreach (var definition in OptimizeSettingDefinitions.All)
+            {
+                var result = new OptimizeResolvedValue { Value = definition.DefaultValue, Source = OptimizeSettingSource.Default };
+
+                var savedText = getSaved(definition.Name);
+
+                if (!string.IsNullOrWhiteSpace(savedText))
+                {
+                    if (definition.TryParse(savedText, false, out var saved, out var savedError))
+                    {
+                        result.SavedValue = saved;
+                        result.Value = saved;
+                        result.Source = OptimizeSettingSource.Saved;
+                    }
+                    else
+                    {
+                        result.SavedError = savedError;
+                        Warn(logger, warned, "Ignoring saved Optimize setting {0}='{1}': {2}. Using the default of {3}.", definition.Name, savedText, savedError, definition.DefaultText);
+                    }
+                }
+
+                var environmentText = definition.EnvironmentVariable == null ? null : getEnvironment(definition.EnvironmentVariable);
+
+                if (!string.IsNullOrWhiteSpace(environmentText))
+                {
+                    result.EnvironmentText = environmentText;
+
+                    if (definition.TryParse(environmentText, true, out var fromEnvironment, out var environmentError))
+                    {
+                        result.Value = fromEnvironment;
+                        result.Source = OptimizeSettingSource.Environment;
+                    }
+                    else
+                    {
+                        result.EnvironmentError = environmentError;
+                        Warn(logger, warned, "Ignoring {0}='{1}': {2}. Using {3}.", definition.EnvironmentVariable, environmentText, environmentError,
+                            result.Source == OptimizeSettingSource.Saved ? "the value saved on the Optimize page" : "the default of " + definition.DefaultText);
+                    }
+                }
+
+                resolved[definition.Name] = result;
+                typeof(OptimizeSettings).GetProperty(definition.Name).SetValue(settings, result.Value);
+            }
+
+            var hitValue = resolved["CacheHitValue"];
+
+            if (hitValue.Source == OptimizeSettingSource.Environment && string.IsNullOrEmpty(settings.CacheHitHeader))
+            {
+                Warn(logger, warned, "Ignoring {0}: {1} is not set and no cache hit header is saved on the Optimize page.",
+                    IndexerRateLimitOptions.CacheHitValueVariable, IndexerRateLimitOptions.CacheHitHeaderVariable);
+            }
+
+            settings.Resolved = resolved;
+            settings.Derive();
+
+            return settings;
+        }
+
+        // A copy with other rate-limit options (tests and the IndexerRateLimitOptions.Current setter).
+        internal OptimizeSettings WithRateLimit(IndexerRateLimitOptions options)
+        {
+            var copy = (OptimizeSettings)MemberwiseClone();
+            copy.RateLimit = options;
+            return copy;
+        }
+
+        // A copy with another ffprobe timeout (tests and the VideoFileInfoReader.ProbeTimeout setter).
+        internal OptimizeSettings WithFfprobeTimeout(TimeSpan timeout)
+        {
+            var copy = (OptimizeSettings)MemberwiseClone();
+            copy.FfprobeTimeout = timeout;
+            return copy;
+        }
+
+        // A copy with some values replaced (tests).
+        internal OptimizeSettings With(IDictionary<string, object> values)
+        {
+            var saved = new Dictionary<string, string>();
+
+            foreach (var pair in Resolved)
+            {
+                if (pair.Value.Source != OptimizeSettingSource.Default)
+                {
+                    saved[pair.Key] = OptimizeSettingDefinition.Format(pair.Value.Value);
+                }
+            }
+
+            foreach (var pair in values)
+            {
+                saved[pair.Key] = OptimizeSettingDefinition.Format(pair.Value);
+            }
+
+            return Resolve(_ => null, n => saved.TryGetValue(n, out var v) ? v : null, null);
+        }
+
+        private void Derive()
+        {
+            RateLimit = new IndexerRateLimitOptions(TimeSpan.FromMilliseconds(IndexerRateLimitMs), CacheHitHeader, CacheHitValue, TimeSpan.FromMilliseconds(GrabSpacingMs));
+            FfprobeTimeout = TimeSpan.FromMinutes(FfprobeTimeoutMinutes);
+            CfCacheLifetimeMs = CfCacheLifetimeMinutes * 60L * 1000;
+            CfCacheSweepMs = CfCacheSweepSeconds * 1000L;
+            CfCacheEvictionBatch = Math.Max(1, CfCacheCapacity / CustomFormats.CustomFormatMatchCache.EvictionDivisor);
+
+            var maxBytes = FfprobeCacheMaxMb * 1024L * 1024;
+            ProbeCache = new ProbeCacheLimits
+            {
+                Enabled = FfprobeCacheCapacity > 0 && maxBytes > 0,
+                Capacity = FfprobeCacheCapacity,
+                EvictionBatch = FfprobeCacheCapacity / MediaFiles.MediaInfo.MediaInfoProbeCache.EvictionDivisor,
+                MaxBytes = maxBytes,
+                MaxEntryBytes = Math.Min(maxBytes, FfprobeCacheMaxEntryKb * 1024L),
+                IdleLifetimeMs = FfprobeCacheIdleMinutes * 60L * 1000,
+                FailureLifetimeMs = FfprobeCacheFailureMinutes * 60L * 1000,
+                SettleTime = TimeSpan.FromSeconds(FfprobeCacheSettleSeconds),
+                UnsettledLifetimeMs = FfprobeCacheUnsettledSeconds * 1000L,
+                SweepIntervalMs = FfprobeCacheSweepSeconds * 1000L
+            };
+        }
+
+        private static void Warn(Logger logger, ISet<string> warned, string format, params object[] args)
+        {
+            if (logger == null)
+            {
+                return;
+            }
+
+            var message = string.Format(System.Globalization.CultureInfo.InvariantCulture, format, args);
+
+            if (warned != null)
+            {
+                lock (warned)
+                {
+                    if (!warned.Add(message))
+                    {
+                        return;
+                    }
+                }
+            }
+
+            logger.Warn(message);
+        }
+    }
+}
diff --git a/src/NzbDrone.Core/Optimization/OptimizeSettingsService.cs b/src/NzbDrone.Core/Optimization/OptimizeSettingsService.cs
new file mode 100644
index 0000000000..557008ef53
--- /dev/null
+++ b/src/NzbDrone.Core/Optimization/OptimizeSettingsService.cs
@@ -0,0 +1,400 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Linq;
+using System.Threading;
+using NLog;
+using NzbDrone.Core.Blocklisting;
+using NzbDrone.Core.Configuration;
+using NzbDrone.Core.Configuration.Events;
+using NzbDrone.Core.CustomFormats;
+using NzbDrone.Core.DecisionEngine;
+using NzbDrone.Core.Indexers;
+using NzbDrone.Core.Lifecycle;
+using NzbDrone.Core.MediaFiles.MediaInfo;
+using NzbDrone.Core.Messaging.Events;
+
+namespace NzbDrone.Core.Optimization
+{
+    public interface IOptimizeSettingsService
+    {
+        OptimizeSettings Current { get; }
+
+        // Per value: the environment value when locked, otherwise the saved value or null (the default applies).
+        Dictionary<string, object> GetValues();
+        List<OptimizeSettingInfo> GetSettings();
+        List<OptimizeValidationFailure> Validate(IDictionary<string, object> values);
+
+        // Saves every value that is not locked by an environment variable (locked values are ignored) and applies
+        // the result at once.
+        void Save(IDictionary<string, object> values);
+        OptimizeStatus GetStatus();
+        void Refresh();
+    }
+
+    public class OptimizeSettingsService : IOptimizeSettingsService, IHandle<ApplicationStartedEvent>, IHandle<ConfigSavedEvent>
+    {
+        private readonly IConfigService _configService;
+        private readonly Logger _logger;
+        private readonly object _refreshLock = new object();
+        private bool _refreshed;
+
+        // Read the environment through this (tests).
+        internal Func<string, string> GetEnvironmentVariable = Environment.GetEnvironmentVariable;
+
+        public OptimizeSettingsService(IConfigService configService, Logger logger)
+        {
+            _configService = configService;
+            _logger = logger;
+        }
+
+        public OptimizeSettings Current => OptimizeSettings.Current;
+
+        public void Handle(ApplicationStartedEvent message)
+        {
+            Refresh();
+        }
+
+        public void Handle(ConfigSavedEvent message)
+        {
+            Refresh();
+        }
+
+        public void Refresh()
+        {
+            lock (_refreshLock)
+            {
+                OptimizeSettings settings;
+
+                try
+                {
+                    settings = OptimizeSettings.Resolve(GetEnvironmentVariable, _configService.GetOptimizeValue, _logger, OptimizeSettings.Warned);
+                }
+                catch (Exception ex)
+                {
+                    _logger.Error(ex, "Unable to read the Optimize settings, keeping the current ones");
+                    return;
+                }
+
+                var previous = OptimizeSettings.Published;
+                OptimizeSettings.Current = settings;
+
+                CustomFormatMatchCache.Apply(settings);
+                MediaInfoProbeCache.ApplyAll(settings);
+
+                LogChanges(previous, settings, !_refreshed);
+                _refreshed = true;
+            }
+        }
+
+        public Dictionary<string, object> GetValues()
+        {
+            var settings = OptimizeSettings.Current;
+            var values = new Dictionary<string, object>();
+
+            foreach (var definition in OptimizeSettingDefinitions.All)
+            {
+                var resolved = settings.Resolved[definition.Name];
+
+                if (resolved.Locked)
+                {
+                    values[definition.Name] = resolved.Value;
+                }
+                else if (definition.Type == OptimizeValueType.Boolean)
+                {
+                    // A check box has no "not set" state: show the value in effect.
+                    values[definition.Name] = resolved.SavedValue ?? definition.DefaultValue;
+                }
+                else
+                {
+                    values[definition.Name] = resolved.SavedValue;
+                }
+            }
+
+            return values;
+        }
+
+        public List<OptimizeValidationFailure> Validate(IDictionary<string, object> values)
+        {
+            var settings = OptimizeSettings.Current;
+            var failures = new List<OptimizeValidationFailure>();
+
+            foreach (var definition in OptimizeSettingDefinitions.All)
+            {
+                if (settings.Resolved[definition.Name].Locked || !values.TryGetValue(definition.Name, out var value))
+                {
+                    continue;
+                }
+
+                var text = ToStoredText(definition, value);
+
+                if (text.Length > 0 && !definition.TryParse(text, false, out _, out var error))
+                {
+                    failures.Add(new OptimizeValidationFailure(definition.Name, error));
+                }
+            }
+
+            return failures;
+        }
+
+        public void Save(IDictionary<string, object> values)
+        {
+            var failures = Validate(values);
+
+            if (failures.Any())
+            {
+                throw new ArgumentException(string.Join("; ", failures.Select(f => f.Name + ": " + f.Message)));
+            }
+
+            var settings = OptimizeSettings.Current;
+            var stored = new Dictionary<string, string>();
+
+            foreach (var definition in OptimizeSettingDefinitions.All)
+            {
+                if (settings.Resolved[definition.Name].Locked || !values.TryGetValue(definition.Name, out var value))
+                {
+                    continue;
+                }
+
+                stored[definition.Name] = ToStoredText(definition, value);
+            }
+
+            _configService.SaveOptimizeValues(stored);
+
+            Refresh();
+        }
+
+        public List<OptimizeSettingInfo> GetSettings()
+        {
+            var settings = OptimizeSettings.Current;
+            var list = new List<OptimizeSettingInfo>();
+
+            foreach (var definition in OptimizeSettingDefinitions.All)
+            {
+                var resolved = settings.Resolved[definition.Name];
+
+                list.Add(new OptimizeSettingInfo
+                {
+                    Name = definition.Name,
+                    Label = definition.Label,
+                    Section = definition.Section,
+                    Description = definition.Description,
+                    Unit = definition.Unit,
+                    Type = definition.Type.ToString().ToLowerInvariant(),
+                    Editable = !resolved.Locked,
+                    Advanced = definition.Advanced,
+                    Locked = resolved.Locked,
+                    Value = resolved.Value,
+                    DefaultValue = definition.DefaultValue,
+                    SavedValue = resolved.SavedValue,
+                    Source = resolved.Source.ToString().ToLowerInvariant(),
+                    HowToChange = resolved.Locked
+                        ? $"Set by environment variable {definition.EnvironmentVariable}. To change it, change or remove {definition.EnvironmentVariable} on the container and recreate the container."
+                        : $"Change it on this page (applies at once on Save), or set environment variable {definition.EnvironmentVariable} on the container and recreate it; the variable wins over this page.",
+                    EnvironmentVariable = definition.EnvironmentVariable,
+                    EnvironmentValue = resolved.EnvironmentText,
+                    EnvironmentError = resolved.EnvironmentError,
+                    SavedError = resolved.SavedError,
+                    Min = definition.Type == OptimizeValueType.Integer ? definition.Min : null,
+                    Max = definition.Type == OptimizeValueType.Integer ? definition.Max : null,
+                    EnvironmentMax = definition.EnvironmentMax,
+                    Warning = definition.Warning,
+                    WarnBelow = definition.WarnBelow,
+                    WarnAbove = definition.WarnAbove,
+                    WarnWhen = definition.WarnWhen,
+                    CurrentValueRisky = definition.IsRisky(resolved.Value),
+                    Constants = definition.Constants.ToList()
+                });
+            }
+
+            list.AddRange(GetFixedSettings(settings));
+
+            return list;
+        }
+
+        // Values the series relies on that are not settings of their own.
+        internal static List<OptimizeSettingInfo> GetFixedSettings(OptimizeSettings settings)
+        {
+            return new List<OptimizeSettingInfo>
+            {
+                Fixed("CfCacheEvictionBatch", "Custom format cache eviction batch", OptimizeSettingDefinitions.SectionCustomFormats, "entries",
+                    settings.CfCacheEvictionBatch, Math.Max(1, CustomFormatMatchCache.Capacity / CustomFormatMatchCache.EvictionDivisor), "derived",
+                    "When the custom format cache is full, this many least recently used entries are dropped at once.",
+                    $"Follows the custom format cache size (size / {CustomFormatMatchCache.EvictionDivisor}, at least 1). Change the size to change it.",
+                    "CustomFormatMatchCache.EvictionDivisor", "CustomFormatMatchCache.EvictionBatch"),
+                Fixed("FfprobeCacheEvictionBatch", "ffprobe cache eviction batch", OptimizeSettingDefinitions.SectionFfprobeCache, "files",
+                    settings.ProbeCache.EvictionBatch, MediaInfoProbeCache.EvictionBatch, "derived",
+                    "When the ffprobe cache is over its size or memory limit, least recently used results are dropped until this many places and a tenth of the memory limit are free.",
+                    $"Follows the ffprobe cache size and memory limit (1/{MediaInfoProbeCache.EvictionDivisor} of each). Change those to change it.",
+                    "MediaInfoProbeCache.EvictionDivisor", "MediaInfoProbeCache.EvictionBatch"),
+                Fixed("BlocklistLikePatternLimit", "Blocklist title comparison limit", OptimizeSettingDefinitions.SectionDecisions, "bytes",
+                    SqliteLike.MaxPatternBytes, SqliteLike.MaxPatternBytes, "fixed",
+                    "With the read memo on, blocklist titles are compared in memory with SQLite's LIKE rules. A title whose LIKE pattern would be longer than SQLite's own limit (SQLITE_MAX_LIKE_PATTERN_LENGTH) is looked up with the stock SQL query instead, exactly as on stock.",
+                    "Fixed in this build: it mirrors SQLite's compile-time limit, so any other value would make the in-memory comparison differ from the stock SQL query. Constant SqliteLike.MaxPatternBytes; changing it needs a rebuild. To skip the in-memory comparison altogether, turn off \"Read memo per decision batch\".",
+                    "SqliteLike.MaxPatternBytes"),
+                Fixed("IndexerOwnRateLimits", "Indexers with their own rate limit", OptimizeSettingDefinitions.SectionIndexers, "ms",
+                    5000, 5000, "fixed",
+                    "Indexer types with their own built-in limit keep it whatever the indexer request spacing is: BroadcasTheNet waits 5000 ms between requests.",
+                    "Fixed in the stock indexer code (BroadcastheNet.RateLimit); not changed by this build. Changing it needs a rebuild."),
+                Fixed("SchedulerInterval", "Scheduler check interval", "Tasks", "s",
+                    30, 30, "fixed",
+                    "How often the scheduler looks for due tasks (RSS sync, backups, housekeeping). Each scheduler now owns its timer, so in-app restarts no longer stack timers; the interval is the stock one.",
+                    "Fixed stock value (Scheduler timer, 30 s); this build only fixes the timer's ownership. Changing it needs a rebuild."),
+                Fixed("ImportRetryInterval", "Failed import retry", "Tasks", "min",
+                    1, 1, "fixed",
+                    "An automatic import that throws an error goes back to \"import pending\" and is retried at the next Refresh Monitored Downloads run, without back-off.",
+                    "Follows the stock Refresh Monitored Downloads task (every minute, TaskManager); not adjustable in the stock app either."),
+                Fixed("DuplicateExtraFilesCleanup", "Duplicate extra files cleanup", "Tasks", "h",
+                    24, 24, "fixed",
+                    "The housekeeping task that removes duplicate extra file rows (keeping the newest row per file) runs with the stock daily housekeeping.",
+                    "Follows the stock Housekeeping task (every 24 h, TaskManager); not adjustable in the stock app either.")
+            };
+        }
+
+        private static OptimizeSettingInfo Fixed(string name, string label, string section, string unit, object value, object defaultValue, string source,
+            string description, string howToChange, params string[] constants)
+        {
+            return new OptimizeSettingInfo
+            {
+                Name = name,
+                Label = label,
+                Section = section,
+                Unit = unit,
+                Type = "integer",
+                Editable = false,
+                Advanced = true,
+                Value = value,
+                DefaultValue = defaultValue,
+                Source = source,
+                Description = description,
+                HowToChange = howToChange,
+                Constants = constants.ToList()
+            };
+        }
+
+        public OptimizeStatus GetStatus()
+        {
+            var settings = OptimizeSettings.Current;
+            MediaInfoProbeCache.Totals(out var probeEntries, out var probeBytes, out var probeHits, out var probeMisses);
+
+            var status = new OptimizeStatus
+            {
+                StartedAt = Process.GetCurrentProcess().StartTime.ToUniversalTime()
+            };
+
+            var rateLimitDefault = settings.Resolved["IndexerRateLimitMs"].Source == OptimizeSettingSource.Default;
+
+            status.Optimizations.Add(Item("Custom format match cache", "Remembers which custom formats match a release input; scores and decisions stay live.",
+                settings.CfCacheCapacity > 0, settings.CfCacheCapacity > 0 ? $"on, {settings.CfCacheCapacity:N0} entries" : "off (stock matching)"));
+            Add(status, "Read memo per decision batch", "Rows every release re-reads in one search or RSS sync are read once; blocklist titles are compared in memory with SQLite's LIKE rules.",
+                settings.DecisionMemoEnabled, settings.DecisionMemoEnabled ? "on" : "off (stock reads)");
+            Add(status, "Indexer request spacing", "Minimum time between requests to one indexer.",
+                !rateLimitDefault, $"{settings.IndexerRateLimitMs} ms" + (rateLimitDefault ? " (stock)" : string.Empty));
+            Add(status, "Cache hit refund", "A response marked as a cache hit releases its rate-limit slot.",
+                !string.IsNullOrEmpty(settings.CacheHitHeader), string.IsNullOrEmpty(settings.CacheHitHeader) ? "off (stock)" : $"{settings.CacheHitHeader}: {settings.CacheHitValue}");
+            Add(status, "Grab spacing", "Minimum time between grabs from one host.",
+                settings.GrabSpacingMs != (int)IndexerRateLimitOptions.GrabRateLimit.TotalMilliseconds, $"{settings.GrabSpacingMs} ms");
+            Add(status, "ffprobe result cache", "An unchanged file is not probed again.",
+                settings.ProbeCache.Enabled, settings.ProbeCache.Enabled ? $"on, {settings.FfprobeCacheCapacity:N0} files / {settings.FfprobeCacheMaxMb} MB" : "off (stock probing)");
+            Add(status, "ffprobe timeout", "A hung ffprobe is stopped and the import retried later.",
+                settings.FfprobeTimeout > TimeSpan.Zero, settings.FfprobeTimeout > TimeSpan.Zero ? $"{settings.FfprobeTimeoutMinutes} min" : "off (stock: no timeout)");
+            Add(status, "Faster history total and series statistics", "Same numbers as stock, computed with a lookup instead of a scan.", true, "built in");
+            Add(status, "Import retry", "Imports that throw are retried at the next check; downloads with no matched episodes are not marked imported.", true, "built in");
+            Add(status, "Scheduler timer per host", "In-app restarts no longer stack scheduler timers.", true, "built in");
+            Add(status, "Duplicate extra files", "No duplicate rows when an -orig metadata file is replaced; existing duplicates are cleaned up daily.", true, "built in");
+
+            Counter(status, "cfCacheEntries", "Entries", "Custom format cache", CustomFormatMatchCache.Count, null, "Results held now.");
+            Counter(status, "cfCacheHits", "Hits", "Custom format cache", Interlocked.Read(ref CustomFormatMatchCache.Hits), null, "Matches answered from the cache.");
+            Counter(status, "cfCacheMisses", "Misses", "Custom format cache", Interlocked.Read(ref CustomFormatMatchCache.Misses), null, "Matches computed and stored.");
+            Counter(status, "cfCacheEvictions", "Evictions", "Custom format cache", Interlocked.Read(ref CustomFormatMatchCache.Evictions), null, "Entries dropped because the cache was full.");
+            Counter(status, "cfCacheExpirations", "Expired", "Custom format cache", Interlocked.Read(ref CustomFormatMatchCache.Expirations), null, "Entries dropped after the idle lifetime.");
+
+            Counter(status, "ffprobeCacheEntries", "Entries", "ffprobe cache", probeEntries, null, "Files whose result is held now.");
+            Counter(status, "ffprobeCacheKilobytes", "Memory", "ffprobe cache", probeBytes / 1024, "KB", "Estimated memory of the held results.");
+            Counter(status, "ffprobeCacheHits", "Hits", "ffprobe cache", probeHits, null, "Media info reads answered without running ffprobe.");
+            Counter(status, "ffprobeCacheMisses", "Misses", "ffprobe cache", probeMisses, null, "Media info reads that ran ffprobe.");
+            Counter(status, "ffprobeTimeouts", "Timeouts", "ffprobe cache", Interlocked.Read(ref VideoFileInfoReader.Timeouts), null, "ffprobe runs stopped by the timeout.");
+
+            Counter(status, "decisionBatches", "Batches", "Read memo", Interlocked.Read(ref DecisionScope.Batches), null, "Searches and RSS syncs decided with the memo.");
+            Counter(status, "memoHits", "Rows reused", "Read memo", Interlocked.Read(ref DecisionScope.MemoHits), null, "Lookups answered from the memo instead of the database.");
+            Counter(status, "memoLoads", "Rows read", "Read memo", Interlocked.Read(ref DecisionScope.MemoLoads), null, "Lookups that read the database.");
+
+            Counter(status, "rateLimitPacedRequests", "Paced requests", "Indexer rate limit", Interlocked.Read(ref IndexerCacheHitRateLimiter.PacedRequestCount), null, "Indexer requests paced with cache hit refund on.");
+            Counter(status, "rateLimitDelayedRequests", "Requests that waited", "Indexer rate limit", Interlocked.Read(ref IndexerCacheHitRateLimiter.DelayedRequestCount), null, "Of those, requests that had to wait.");
+            Counter(status, "rateLimitWaitMs", "Total wait", "Indexer rate limit", Interlocked.Read(ref IndexerCacheHitRateLimiter.DelayTicksTotal) / TimeSpan.TicksPerMillisecond, "ms", "Time those requests waited.");
+            Counter(status, "rateLimitCacheHits", "Cache hit responses", "Indexer rate limit", Interlocked.Read(ref IndexerCacheHitRateLimiter.CacheHitResponseCount), null, "Responses carrying the cache hit header and value.");
+            Counter(status, "rateLimitRefunds", "Refunds", "Indexer rate limit", Interlocked.Read(ref IndexerCacheHitRateLimiter.RefundCount), null, "Rate-limit slots released by a cache hit.");
+            Counter(status, "rateLimitRefundedMs", "Wait released", "Indexer rate limit", Interlocked.Read(ref IndexerCacheHitRateLimiter.RefundedTicksTotal) / TimeSpan.TicksPerMillisecond, "ms", "Upper bound of the wait saved by refunds.");
+
+            return status;
+        }
+
+        private static OptimizeStatusItem Item(string name, string description, bool active, string state)
+        {
+            return new OptimizeStatusItem { Name = name, Description = description, Active = active, State = state };
+        }
+
+        private static void Add(OptimizeStatus status, string name, string description, bool active, string state)
+        {
+            status.Optimizations.Add(Item(name, description, active, state));
+        }
+
+        private static void Counter(OptimizeStatus status, string name, string label, string group, long value, string unit, string description)
+        {
+            status.Counters.Add(new OptimizeCounter { Name = name, Label = label, Group = group, Value = value, Unit = unit, Description = description });
+        }
+
+        internal static string ToStoredText(OptimizeSettingDefinition definition, object value)
+        {
+            if (value == null)
+            {
+                return string.Empty;
+            }
+
+            if (definition.Type == OptimizeValueType.Boolean && value is bool b && b == (bool)definition.DefaultValue)
+            {
+                // The default needs no saved value.
+                return string.Empty;
+            }
+
+            return (OptimizeSettingDefinition.Format(value) ?? string.Empty).Trim();
+        }
+
+        // An empty text value turns its feature off (the cache hit header), so the log says "off" instead of nothing.
+        internal static string LogText(OptimizeSettingDefinition definition, object value)
+        {
+            var text = OptimizeSettingDefinition.Format(value);
+
+            return definition.Type == OptimizeValueType.Text && string.IsNullOrEmpty(text) ? "off" : text;
+        }
+
+        // The first time every value that is not the default, then every change.
+        private void LogChanges(OptimizeSettings previous, OptimizeSettings settings, bool first)
+        {
+            foreach (var definition in OptimizeSettingDefinitions.All)
+            {
+                var now = settings.Resolved[definition.Name];
+                OptimizeResolvedValue before = null;
+                previous?.Resolved?.TryGetValue(definition.Name, out before);
+
+                var changed = before == null || !Equals(before.Value, now.Value) || before.Source != now.Source;
+
+                if (first ? now.Source == OptimizeSettingSource.Default : !changed)
+                {
+                    continue;
+                }
+
+                var source = now.Source switch
+                {
+                    OptimizeSettingSource.Environment => "set by " + definition.EnvironmentVariable,
+                    OptimizeSettingSource.Saved => "saved on the Optimize page",
+                    _ => "default"
+                };
+
+                var origin = now.Source == OptimizeSettingSource.Default ? source : $"{source}, default {LogText(definition, definition.DefaultValue)}";
+
+                _logger.Info("Optimize: {0} = {1}{2} ({3})", definition.Label, LogText(definition, now.Value), definition.Unit == null ? string.Empty : " " + definition.Unit, origin);
+            }
+        }
+    }
+}
