+using System.Collections.Generic;
+using FluentValidation;
+using Microsoft.AspNetCore.Mvc;
+using NzbDrone.Core.Configuration;
+using NzbDrone.Core.Optimization;
+using Sonarr.Http;
+using Sonarr.Http.REST.Attributes;
+
+namespace Sonarr.Api.V3.Config
+{
+    // GET/PUT /api/v3/config/optimize: the Optimize page values. Invalid values are rejected with 400 and one error
+    // per field. Values locked by an environment variable are ignored on PUT (they keep the environment value).
+    // GET /api/v3/config/optimize/settings: every tunable value; GET /api/v3/config/optimize/status: what is built in
+    // and counters since start-up.
+    [V3ApiController("config/optimize")]
+    public class OptimizeConfigController : ConfigController<OptimizeConfigResource>
+    {
+        private readonly IOptimizeSettingsService _optimizeSettingsService;
+
+        public OptimizeConfigController(IConfigService configService, IOptimizeSettingsService optimizeSettingsService)
+            : base(configService)
+        {
+            _optimizeSettingsService = optimizeSettingsService;
+
+            SharedValidator.RuleFor(c => c).Custom((resource, context) =>
+            {
+                foreach (var failure in _optimizeSettingsService.Validate(resource.ToValues()))
+                {
+                    context.AddFailure(failure.Name, failure.Message);
+                }
+            });
+        }
+
+        [HttpGet("settings")]
+        [Produces("application/json")]
+        public List<OptimizeSettingInfo> GetSettings()
+        {
+            return _optimizeSettingsService.GetSettings();
+        }
+
+        [HttpGet("status")]
+        [Produces("application/json")]
+        public OptimizeStatus GetStatus()
+        {
+            return _optimizeSettingsService.GetStatus();
+        }
+
+        [RestPutById]
+        [Consumes("application/json")]
+        public override ActionResult<OptimizeConfigResource> SaveConfig([FromBody] OptimizeConfigResource resource)
+        {
+            _optimizeSettingsService.Save(resource.ToValues());
+
+            return Accepted(resource.Id);
+        }
+
+        protected override OptimizeConfigResource ToResource(IConfigService model)
+        {
+            return OptimizeConfigResourceMapper.ToResource(_optimizeSettingsService);
+        }
+    }
+}
