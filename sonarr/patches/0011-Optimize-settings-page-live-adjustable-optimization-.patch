+import React, { useCallback, useMemo } from 'react';
+import Alert from 'Components/Alert';
+import FieldSet from 'Components/FieldSet';
+import Form from 'Components/Form/Form';
+import FormInput from 'Components/Form/FormInput';
+import FormInputButton from 'Components/Form/FormInputButton';
+import FormInputHelpText from 'Components/Form/FormInputHelpText';
+import FormLabel from 'Components/Form/FormLabel';
+import FormRow from 'Components/Form/FormRow';
+import Label from 'Components/Label';
+import Button from 'Components/Link/Button';
+import SpinnerButton from 'Components/Link/SpinnerButton';
+import LoadingIndicator from 'Components/Loading/LoadingIndicator';
+import PageContentBody from 'Components/Page/PageContentBody';
+import PageHeading from 'Components/Page/PageHeading';
+import { icons, inputTypes, kinds, sizes } from 'Helpers/Props';
+import settingsStyles from 'Settings/Settings.module.css';
+import SettingsPage from 'Settings/SettingsPage';
+import { InputChanged } from 'typings/inputs';
+import { Failure } from 'typings/pending';
+import {
+  OptimizeSettingInfo,
+  OptimizeSettingsModel,
+  OptimizeValue,
+  useManageOptimizeSettings,
+  useOptimizeStatus,
+} from './useOptimizeSettings';
+import styles from './OptimizeSettings.module.css';
+
+// English only: the app's translation files are not part of this build.
+
+const ADVANCED_WARNING =
+  'These control internal caches and safety limits. The defaults are tested; changing them can use more memory, hit download hosts faster, or make imports slower. Use Reset to default if unsure.';
+
+function camelName(name: string) {
+  return (name.charAt(0).toLowerCase() +
+    name.slice(1)) as keyof OptimizeSettingsModel;
+}
+
+export function formatOptimizeValue(
+  value: OptimizeValue,
+  info: Pick<OptimizeSettingInfo, 'type' | 'unit' | 'name'>
+) {
+  if (value === null || value === undefined) {
+    return '-';
+  }
+
+  if (info.type === 'boolean' || typeof value === 'boolean') {
+    return value ? 'On' : 'Off';
+  }
+
+  if (typeof value === 'string') {
+    if (value === '') {
+      return info.name === 'CacheHitHeader' ? 'Off (empty)' : '(empty)';
+    }
+
+    return value;
+  }
+
+  const number = value.toLocaleString();
+
+  return info.unit ? `${number} ${info.unit}` : number;
+}
+
+export function isRisky(info: OptimizeSettingInfo, value: OptimizeValue) {
+  if (!info.warning || value === null || value === undefined) {
+    return false;
+  }
+
+  if (typeof value === 'boolean') {
+    return info.warnWhen !== null && info.warnWhen === value;
+  }
+
+  if (typeof value === 'number') {
+    return (
+      (info.warnBelow !== null && value < info.warnBelow) ||
+      (info.warnAbove !== null && value > info.warnAbove)
+    );
+  }
+
+  return false;
+}
+
+function sourceLabel(info: OptimizeSettingInfo): {
+  kind: 'default' | 'info' | 'warning';
+  text: string;
+} {
+  switch (info.source) {
+    case 'environment':
+      return { kind: kinds.WARNING, text: 'Environment (locked)' };
+    case 'saved':
+      return { kind: kinds.INFO, text: 'Saved on this page' };
+    case 'derived':
+      return { kind: kinds.DEFAULT, text: 'Derived' };
+    case 'fixed':
+      return { kind: kinds.DEFAULT, text: 'Fixed' };
+    default:
+      return { kind: kinds.DEFAULT, text: 'Default' };
+  }
+}
+
+interface OptimizeFieldProps {
+  info: OptimizeSettingInfo;
+  setting: {
+    value: OptimizeValue;
+    errors: Failure[];
+    warnings: Failure[];
+    pending?: boolean;
+  };
+  onChange: (change: InputChanged) => void;
+  onReset: (info: OptimizeSettingInfo) => void;
+}
+
+function OptimizeField({
+  info,
+  setting,
+  onChange,
+  onReset,
+}: OptimizeFieldProps) {
+  const name = camelName(info.name);
+  const value = setting?.value ?? null;
+  const effective = value ?? info.defaultValue;
+  const isDefaultValue =
+    value === null ||
+    value === '' ||
+    (info.type === 'boolean' && value === info.defaultValue);
+
+  const allowed =
+    info.type === 'integer'
+      ? ` Allowed: ${info.min?.toLocaleString()} to ${info.max?.toLocaleString()}${
+          info.unit ? ` ${info.unit}` : ''
+        }.`
+      : '';
+
+  const handleResetPress = useCallback(() => {
+    onReset(info);
+  }, [info, onReset]);
+
+  const resetButton = (
+    <FormInputButton
+      key="reset"
+      kind={kinds.DEFAULT}
+      title={`Reset to default (${formatOptimizeValue(
+        info.defaultValue,
+        info
+      )})`}
+      isDisabled={info.locked || isDefaultValue}
+      onPress={handleResetPress}
+    >
+      Reset
+    </FormInputButton>
+  );
+
+  const common = {
+    name,
+    errors: setting?.errors,
+    warnings: setting?.warnings,
+    pending: setting?.pending,
+    onChange,
+    buttons: [resetButton],
+  };
+
+  let input: React.ReactNode = null;
+
+  if (info.type === 'boolean') {
+    // A bare check box like on the other settings pages, with Reset as a
+    // separate button instead of an input group.
+    input = (
+      <div className={styles.checkInput}>
+        <FormInput
+          name={name}
+          errors={setting?.errors}
+          warnings={setting?.warnings}
+          pending={setting?.pending}
+          type={inputTypes.CHECK}
+          value={Boolean(effective)}
+          isDisabled={info.locked}
+          onChange={onChange}
+        />
+
+        <Button
+          className={styles.checkResetButton}
+          kind={kinds.DEFAULT}
+          size={sizes.SMALL}
+          title={`Reset to default (${formatOptimizeValue(
+            info.defaultValue,
+            info
+          )})`}
+          isDisabled={info.locked || isDefaultValue}
+          onPress={handleResetPress}
+        >
+          Reset
+        </Button>
+      </div>
+    );
+  } else if (info.type === 'integer') {
+    input = (
+      <FormInput
+        {...common}
+        type={inputTypes.NUMBER}
+        value={value as number | null}
+        min={info.min ?? undefined}
+        max={info.locked ? undefined : info.max ?? undefined}
+        unit={info.unit ?? undefined}
+        placeholder={`${formatOptimizeValue(info.defaultValue, {
+          ...info,
+          unit: null,
+        })} (default)`}
+        readOnly={info.locked}
+      />
+    );
+  } else {
+    input = (
+      <FormInput
+        {...common}
+        type={inputTypes.TEXT}
+        value={(value as string | null) ?? ''}
+        placeholder={
+          info.defaultValue
+            ? `${info.defaultValue} (default)`
+            : 'Empty: off (default)'
+        }
+        readOnly={info.locked}
+      />
+    );
+  }
+
+  return (
+    <FormRow>
+      <FormLabel>{info.label}</FormLabel>
+
+      <FormInputHelpText text={info.description} />
+
+      <FormInputHelpText
+        text={`Default: ${formatOptimizeValue(
+          info.defaultValue,
+          info
+        )}.${allowed}${
+          info.environmentVariable
+            ? ` Environment variable: ${info.environmentVariable}.`
+            : ''
+        }`}
+      />
+
+      {info.locked ? (
+        <FormInputHelpText
+          text={`Set by environment variable ${info.environmentVariable}`}
+          isWarning={true}
+        />
+      ) : null}
+
+      {info.environmentError ? (
+        <FormInputHelpText
+          text={`${info.environmentVariable}='${info.environmentValue}' is ignored: ${info.environmentError}`}
+          isError={true}
+        />
+      ) : null}
+
+      {isRisky(info, effective) && info.warning ? (
+        <FormInputHelpText text={info.warning} isWarning={true} />
+      ) : null}
+
+      {input}
+    </FormRow>
+  );
+}
+
+function AllSettingsList({ infos }: { infos: OptimizeSettingInfo[] }) {
+  return (
+    <div className={styles.settingsList} role="list">
+      <div className={styles.settingsHeader} aria-hidden="true">
+        <span>Setting</span>
+        <span>Current</span>
+        <span>Default</span>
+        <span>Source / how to change</span>
+      </div>
+
+      {infos.map((info) => {
+        const source = sourceLabel(info);
+
+        return (
+          <div key={info.name} className={styles.settingsItem} role="listitem">
+            <div className={styles.settingsName}>
+              <div className={styles.settingsLabel}>{info.label}</div>
+              <div className={styles.settingsSection}>{info.section}</div>
+              <div className={styles.settingsDescription}>
+                {info.description}
+              </div>
+            </div>
+
+            <div className={styles.settingsValue}>
+              <span className={styles.cellLabel}>Current</span>
+              <span
+                className={
+                  info.currentValueRisky ? styles.riskyValue : undefined
+                }
+              >
+                {formatOptimizeValue(info.value, info)}
+              </span>
+            </div>
+
+            <div className={styles.settingsValue}>
+              <span className={styles.cellLabel}>Default</span>
+              {formatOptimizeValue(info.defaultValue, info)}
+            </div>
+
+            <div className={styles.settingsSource}>
+              <Label kind={source.kind}>{source.text}</Label>
+              <div className={styles.howToChange}>{info.howToChange}</div>
+              {info.constants.length ? (
+                <div className={styles.constants}>
+                  {info.constants.join(', ')}
+                </div>
+              ) : null}
+            </div>
+          </div>
+        );
+      })}
+    </div>
+  );
+}
+
+function StatusSection() {
+  const { data, isFetching, error, refetch } = useOptimizeStatus();
+
+  const groups = useMemo(() => {
+    const result: Record<string, NonNullable<typeof data>['counters']> = {};
+
+    (data?.counters ?? []).forEach((counter) => {
+      result[counter.group] = result[counter.group] ?? [];
+      result[counter.group].push(counter);
+    });
+
+    return result;
+  }, [data]);
+
+  const handleRefreshPress = useCallback(() => {
+    refetch();
+  }, [refetch]);
+
+  return (
+    <FieldSet
+      legend="Status"
+      caption={
+        data
+          ? `Built into this image, and counters since start-up (${new Date(
+              data.startedAt
+            ).toLocaleString()}).`
+          : 'Built into this image, and counters since start-up.'
+      }
+    >
+      <div className={styles.statusActions}>
+        <SpinnerButton
+          kind={kinds.DEFAULT}
+          isSpinning={isFetching}
+          spinnerIcon={icons.REFRESH}
+          onPress={handleRefreshPress}
+        >
+          Refresh
+        </SpinnerButton>
+      </div>
+
+      {error ? (
+        <Alert kind={kinds.DANGER}>Unable to load the status.</Alert>
+      ) : null}
+
+      {data ? (
+        <>
+          <ul className={styles.optimizations}>
+            {data.optimizations.map((item) => (
+              <li key={item.name} className={styles.optimization}>
+                <span className={styles.optimizationName}>{item.name}</span>
+                <span className={styles.optimizationDescription}>
+                  {item.description}
+                </span>
+                <Label kind={item.active ? kinds.SUCCESS : kinds.DEFAULT}>
+                  {item.state}
+                </Label>
+              </li>
+            ))}
+          </ul>
+
+          <div className={styles.counterGroups}>
+            {Object.keys(groups).map((group) => (
+              <div key={group} className={styles.counterGroup}>
+                <div className={styles.counterGroupTitle}>{group}</div>
+                <dl className={styles.counters}>
+                  {groups[group].map((counter) => (
+                    <div
+                      key={counter.name}
+                      className={styles.counter}
+                      title={counter.description}
+                    >
+                      <dt>{counter.label}</dt>
+                      <dd>
+                        {counter.value.toLocaleString()}
+                        {counter.unit ? ` ${counter.unit}` : ''}
+                      </dd>
+                    </div>
+                  ))}
+                </dl>
+              </div>
+            ))}
+          </div>
+        </>
+      ) : null}
+    </FieldSet>
+  );
+}
+
+function OptimizeSettings() {
+  const {
+    isFetching,
+    isFetched,
+    error,
+    settings,
+    infos,
+    hasPendingChanges,
+    hasSettings,
+    isSaving,
+    validationErrors,
+    validationWarnings,
+    saveSettings,
+    updateSetting,
+  } = useManageOptimizeSettings();
+
+  // Settings of their own (locked ones included, shown read-only); derived
+  // and fixed values appear only in the list of all settings.
+  const fieldInfos = useMemo(
+    () =>
+      infos.filter(
+        (info) => info.source !== 'derived' && info.source !== 'fixed'
+      ),
+    [infos]
+  );
+
+  const mainInfos = useMemo(
+    () => fieldInfos.filter((info) => !info.advanced),
+    [fieldInfos]
+  );
+
+  const advancedInfos = useMemo(
+    () => fieldInfos.filter((info) => info.advanced),
+    [fieldInfos]
+  );
+
+  const handleInputChange = useCallback(
+    (change: InputChanged) => {
+      updateSetting(
+        change.name as keyof OptimizeSettingsModel,
+        // Empty text means "not set": the default applies.
+        (change.value === '' ? null : change.value) as never
+      );
+    },
+    [updateSetting]
+  );
+
+  const handleReset = useCallback(
+    (info: OptimizeSettingInfo) => {
+      updateSetting(
+        camelName(info.name),
+        (info.type === 'boolean' ? info.defaultValue : null) as never
+      );
+    },
+    [updateSetting]
+  );
+
+  const handleSavePress = useCallback(() => {
+    saveSettings();
+  }, [saveSettings]);
+
+  const renderField = (info: OptimizeSettingInfo) => {
+    const key = camelName(info.name);
+
+    return (
+      <OptimizeField
+        key={info.name}
+        info={info}
+        // @ts-expect-error - every editable name is a key of the model
+        setting={settings[key]}
+        onChange={handleInputChange}
+        onReset={handleReset}
+      />
+    );
+  };
+
+  const advancedSections = useMemo(() => {
+    const sections: { name: string; infos: OptimizeSettingInfo[] }[] = [];
+
+    advancedInfos.forEach((info) => {
+      let section = sections.find((s) => s.name === info.section);
+
+      if (!section) {
+        section = { name: info.section, infos: [] };
+        sections.push(section);
+      }
