diff --git a/src/NzbDrone.Core/Optimization/OptimizeSettingDefinition.cs b/src/NzbDrone.Core/Optimization/OptimizeSettingDefinition.cs
new file mode 100644
index 0000000000..e02a489679
--- /dev/null
+++ b/src/NzbDrone.Core/Optimization/OptimizeSettingDefinition.cs
@@ -0,0 +1,176 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+
+namespace NzbDrone.Core.Optimization
+{
+    public enum OptimizeValueType
+    {
+        Integer,
+        Text,
+        Boolean
+    }
+
+    // One adjustable value of the Optimize page. The default and the names of the constants it replaces come from
+    // the code that uses the value, so the page and the API can never drift from it.
+    public class OptimizeSettingDefinition
+    {
+        public const string ConfigKeyPrefix = "optimize";
+
+        public string Name { get; set; }
+        public string Label { get; set; }
+        public string Section { get; set; }
+        public string Description { get; set; }
+        public string Unit { get; set; }
+        public OptimizeValueType Type { get; set; }
+        public bool Advanced { get; set; }
+        public object DefaultValue { get; set; }
+
+        // Bounds for a value saved on the page (Integer only).
+        public long Min { get; set; }
+        public long Max { get; set; }
+
+        // Upper bound for the environment variable, when it allows more than the page (kept from earlier releases).
+        public long? EnvironmentMax { get; set; }
+
+        public string EnvironmentVariable { get; set; }
+
+        // Risky values: the warning applies when the value is below WarnBelow, above WarnAbove or equals WarnWhen.
+        public string Warning { get; set; }
+        public long? WarnBelow { get; set; }
+        public long? WarnAbove { get; set; }
+        public bool? WarnWhen { get; set; }
+
+        // "<Class>.<Member>" of every constant whose role this value takes over.
+        public List<string> Constants { get; set; } = new List<string>();
+
+        public string ConfigKey => ConfigKeyPrefix + Name;
+
+        public string DefaultText => Format(DefaultValue);
+
+        public static string Format(object value)
+        {
+            return value switch
+            {
+                null => null,
+                bool b => b ? "true" : "false",
+                IFormattable f => f.ToString(null, CultureInfo.InvariantCulture),
+                _ => value.ToString()
+            };
+        }
+
+        // Parses stored or environment text. Empty text means "not set" and is handled by the caller.
+        public bool TryParse(string text, bool fromEnvironment, out object value, out string error)
+        {
+            value = null;
+            error = null;
+            var trimmed = text?.Trim() ?? string.Empty;
+
+            switch (Type)
+            {
+                case OptimizeValueType.Integer:
+                {
+                    var max = fromEnvironment && EnvironmentMax.HasValue ? EnvironmentMax.Value : Max;
+
+                    // Digits only: no sign, no decimals, no thousands separators.
+                    if (long.TryParse(trimmed, NumberStyles.None, CultureInfo.InvariantCulture, out var number) && number >= Min && number <= max)
+                    {
+                        value = (int)number;
+                        return true;
+                    }
+
+                    error = string.Format(CultureInfo.InvariantCulture, "Must be a whole number from {0} to {1}", Min, max);
+                    return false;
+                }
+
+                case OptimizeValueType.Boolean:
+                {
+                    switch (trimmed.ToLowerInvariant())
+                    {
+                        case "true":
+                        case "1":
+                        case "yes":
+                        case "on":
+                            value = true;
+                            return true;
+                        case "false":
+                        case "0":
+                        case "no":
+                        case "off":
+                            value = false;
+                            return true;
+                        default:
+                            error = "Must be true or false";
+                            return false;
+                    }
+                }
+
+                default:
+                {
+                    if (trimmed.Length > 256)
+                    {
+                        error = "Must be at most 256 characters";
+                        return false;
+                    }
+
+                    var problem = TextValidator?.Invoke(trimmed);
+
+                    if (problem != null)
+                    {
+                        error = problem;
+                        return false;
+                    }
+
+                    value = trimmed;
+                    return true;
+                }
+            }
+        }
+
+        // Extra check of a Text value; returns an error message or null.
+        internal Func<string, string> TextValidator { get; set; }
+
+        public bool IsRisky(object value)
+        {
+            if (Warning == null || value == null)
+            {
+                return false;
+            }
+
+            if (value is bool b)
+            {
+                return WarnWhen.HasValue && WarnWhen.Value == b;
+            }
+
+            if (value is int || value is long)
+            {
+                var number = Convert.ToInt64(value, CultureInfo.InvariantCulture);
+                return (WarnBelow.HasValue && number < WarnBelow.Value) || (WarnAbove.HasValue && number > WarnAbove.Value);
+            }
+
+            return false;
+        }
+
+        internal static bool IsHeaderName(string name)
+        {
+            // RFC 9110 token characters.
+            foreach (var c in name)
+            {
+                var isToken = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || "!#$%&'*+-.^_`|~".IndexOf(c) >= 0;
+
+                if (!isToken)
+                {
+                    return false;
+                }
+            }
+
+            return name.Length > 0;
+        }
+
+        internal static bool IsHeaderValueToken(string value)
+        {
+            return value.IndexOfAny(new[] { ',', ';' }) < 0 && !value.Any(char.IsControl);
+        }
+    }
+}
