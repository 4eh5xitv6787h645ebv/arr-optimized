+      section.infos.push(info);
+    });
+
+    return sections;
+  }, [advancedInfos]);
+
+  return (
+    <SettingsPage
+      title="Optimize"
+      hasPendingChanges={hasPendingChanges}
+      isSaving={isSaving}
+      onSavePress={handleSavePress}
+    >
+      <PageContentBody>
+        <div className={settingsStyles.section}>
+          <PageHeading scope="Settings" title="Optimize" />
+
+          {isFetching && !isFetched ? <LoadingIndicator /> : null}
+
+          {!isFetching && error ? (
+            <Alert kind={kinds.DANGER}>
+              Unable to load the Optimize settings.
+            </Alert>
+          ) : null}
+
+          {hasSettings && isFetched && !error ? (
+            <Form
+              id="optimizeSettings"
+              validationErrors={validationErrors}
+              validationWarnings={validationWarnings}
+            >
+              <div className={styles.intro}>
+                <Alert kind={kinds.INFO}>
+                  Tuning for the optimizations built into this image. With the
+                  defaults, releases are accepted, rejected and scored exactly
+                  as on stock Sonarr. Changes apply as soon as you save; no
+                  restart is needed. A value set by an environment variable on
+                  the container wins and is shown read-only.
+                </Alert>
+              </div>
+
+              <FieldSet
+                legend="Indexers and imports"
+                caption="The main settings. Empty fields use the default."
+              >
+                {mainInfos.map(renderField)}
+              </FieldSet>
+
+              <FieldSet
+                legend="Advanced tuning"
+                caption="Internal caches and safety limits. Every value can be reset to its default."
+                notice={<Alert kind={kinds.WARNING}>{ADVANCED_WARNING}</Alert>}
+              >
+                {advancedSections.map((section) => (
+                  <React.Fragment key={section.name}>
+                    <div className={styles.subsection}>{section.name}</div>
+                    {section.infos.map(renderField)}
+                  </React.Fragment>
+                ))}
+              </FieldSet>
+
+              <FieldSet
+                legend="All optimization settings"
+                caption="Every value this build adds or relies on, with the value in effect, its default and where it comes from. Values that cannot be edited here say how to change them."
+              >
+                <AllSettingsList infos={infos} />
+              </FieldSet>
+            </Form>
+          ) : null}
+
+          <StatusSection />
+        </div>
+      </PageContentBody>
+    </SettingsPage>
+  );
+}
