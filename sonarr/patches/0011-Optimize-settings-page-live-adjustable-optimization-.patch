+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using NzbDrone.Core.Optimization;
+using Sonarr.Http.REST;
+
+namespace Sonarr.Api.V3.Config
+{
+    // Values of the Optimize page. null = not saved (the default applies). A value locked by an environment variable
+    // is returned as the environment value and ignored on PUT; Settings tells which values are locked and where each
+    // value comes from. PUT changes only the values present in the body: a value left out keeps its saved value and
+    // an explicit null resets it to the default.
+    public class OptimizeConfigResource : RestResource
+    {
+        // Names of the values present in the request body (the JSON reader calls a setter only for a property it
+        // finds). PUT changes only those: a value left out keeps what is saved, an explicit null resets it.
+        private readonly HashSet<string> _assigned = new HashSet<string>();
+        private int? _indexerRateLimitMs;
+        private string _cacheHitHeader;
+        private string _cacheHitValue;
+        private int? _ffprobeTimeoutMinutes;
+        private int? _grabSpacingMs;
+        private int? _cfCacheCapacity;
+        private int? _cfCacheLifetimeMinutes;
+        private int? _cfCacheMaxKeyChars;
+        private int? _cfCacheSweepSeconds;
+        private bool? _decisionMemoEnabled;
+        private int? _ffprobeCacheCapacity;
+        private int? _ffprobeCacheMaxMb;
+        private int? _ffprobeCacheMaxEntryKb;
+        private int? _ffprobeCacheIdleMinutes;
+        private int? _ffprobeCacheFailureMinutes;
+        private int? _ffprobeCacheSettleSeconds;
+        private int? _ffprobeCacheUnsettledSeconds;
+        private int? _ffprobeCacheSweepSeconds;
+
+        public int? IndexerRateLimitMs
+        {
+            get => _indexerRateLimitMs;
+            set => Set(ref _indexerRateLimitMs, value);
+        }
+
+        public string CacheHitHeader
+        {
+            get => _cacheHitHeader;
+            set => Set(ref _cacheHitHeader, value);
+        }
+
+        public string CacheHitValue
+        {
+            get => _cacheHitValue;
+            set => Set(ref _cacheHitValue, value);
+        }
+
+        public int? FfprobeTimeoutMinutes
+        {
+            get => _ffprobeTimeoutMinutes;
+            set => Set(ref _ffprobeTimeoutMinutes, value);
+        }
+
+        public int? GrabSpacingMs
+        {
+            get => _grabSpacingMs;
+            set => Set(ref _grabSpacingMs, value);
+        }
+
+        public int? CfCacheCapacity
+        {
+            get => _cfCacheCapacity;
+            set => Set(ref _cfCacheCapacity, value);
+        }
+
+        public int? CfCacheLifetimeMinutes
+        {
+            get => _cfCacheLifetimeMinutes;
+            set => Set(ref _cfCacheLifetimeMinutes, value);
+        }
+
+        public int? CfCacheMaxKeyChars
+        {
+            get => _cfCacheMaxKeyChars;
+            set => Set(ref _cfCacheMaxKeyChars, value);
+        }
+
+        public int? CfCacheSweepSeconds
+        {
+            get => _cfCacheSweepSeconds;
+            set => Set(ref _cfCacheSweepSeconds, value);
+        }
+
+        public bool? DecisionMemoEnabled
+        {
+            get => _decisionMemoEnabled;
+            set => Set(ref _decisionMemoEnabled, value);
+        }
+
+        public int? FfprobeCacheCapacity
+        {
+            get => _ffprobeCacheCapacity;
+            set => Set(ref _ffprobeCacheCapacity, value);
+        }
+
+        public int? FfprobeCacheMaxMb
+        {
+            get => _ffprobeCacheMaxMb;
+            set => Set(ref _ffprobeCacheMaxMb, value);
+        }
+
+        public int? FfprobeCacheMaxEntryKb
+        {
+            get => _ffprobeCacheMaxEntryKb;
+            set => Set(ref _ffprobeCacheMaxEntryKb, value);
+        }
+
+        public int? FfprobeCacheIdleMinutes
+        {
+            get => _ffprobeCacheIdleMinutes;
+            set => Set(ref _ffprobeCacheIdleMinutes, value);
+        }
+
+        public int? FfprobeCacheFailureMinutes
+        {
+            get => _ffprobeCacheFailureMinutes;
+            set => Set(ref _ffprobeCacheFailureMinutes, value);
+        }
+
+        public int? FfprobeCacheSettleSeconds
+        {
+            get => _ffprobeCacheSettleSeconds;
+            set => Set(ref _ffprobeCacheSettleSeconds, value);
+        }
+
+        public int? FfprobeCacheUnsettledSeconds
+        {
+            get => _ffprobeCacheUnsettledSeconds;
+            set => Set(ref _ffprobeCacheUnsettledSeconds, value);
+        }
+
+        public int? FfprobeCacheSweepSeconds
+        {
+            get => _ffprobeCacheSweepSeconds;
+            set => Set(ref _ffprobeCacheSweepSeconds, value);
+        }
+
+        // Read-only: every tunable value with its current and default value and where it comes from.
+        public List<OptimizeSettingInfo> Settings { get; set; }
+
+        internal bool IsAssigned(string name)
+        {
+            return _assigned.Contains(name);
+        }
+
+        private void Set<T>(ref T field, T value, [CallerMemberName] string name = null)
+        {
+            field = value;
+            _assigned.Add(name);
+        }
+    }
+
+    public static class OptimizeConfigResourceMapper
+    {
+        private static readonly Dictionary<string, PropertyInfo> Properties = OptimizeSettingDefinitions.All
+            .ToDictionary(d => d.Name, d => typeof(OptimizeConfigResource).GetProperty(d.Name));
+
+        public static OptimizeConfigResource ToResource(IOptimizeSettingsService service)
+        {
+            var resource = new OptimizeConfigResource { Settings = service.GetSettings() };
+
+            foreach (var pair in service.GetValues())
+            {
+                var property = Properties[pair.Key];
+                var type = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
+
+                property.SetValue(resource, pair.Value == null ? null : Convert.ChangeType(pair.Value, type, CultureInfo.InvariantCulture));
+            }
+
+            return resource;
+        }
+
+        // The values present in the request (see OptimizeConfigResource).
+        public static Dictionary<string, object> ToValues(this OptimizeConfigResource resource)
+        {
+            return Properties.Where(p => resource.IsAssigned(p.Key)).ToDictionary(p => p.Key, p => p.Value.GetValue(resource));
+        }
+    }
+}
