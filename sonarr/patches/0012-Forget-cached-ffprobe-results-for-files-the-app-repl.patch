--- a/src/NzbDrone.Core/MediaFiles/MediaInfo/VideoFileInfoReader.cs
+++ b/src/NzbDrone.Core/MediaFiles/MediaInfo/VideoFileInfoReader.cs
@@ -8,6 +8,8 @@
 using NLog;
 using NzbDrone.Common.Disk;
 using NzbDrone.Common.Extensions;
+using NzbDrone.Core.MediaFiles.Events;
+using NzbDrone.Core.Messaging.Events;
 using NzbDrone.Core.Optimization;
 
 namespace NzbDrone.Core.MediaFiles.MediaInfo
@@ -18,7 +20,10 @@ public interface IVideoFileInfoReader
         TimeSpan? GetRunTime(string filename);
     }
 
-    public class VideoFileInfoReader : IVideoFileInfoReader
+    public class VideoFileInfoReader : IVideoFileInfoReader,
+        IHandle<EpisodeImportedEvent>,
+        IHandle<EpisodeFileDeletedEvent>,
+        IHandle<EpisodeFileRenamedEvent>
     {
         private readonly IDiskProvider _diskProvider;
         private readonly Logger _logger;
@@ -83,18 +88,58 @@ public MediaInfoModel GetMediaInfo(string filename)
                 return cachedMediaInfo;
             }
 
+            var generation = _probeCache.Generation;
             var probeStarted = MediaInfoProbeCache.UtcNow();
             var mediaInfo = ProbeMediaInfo(filename);
 
             // Remember the result only if the file did not change while it was probed
             if (TryGetFileStamp(filename, out var stampAfter) && stampAfter.Equals(stamp))
             {
-                _probeCache.Add(filename, stamp, mediaInfo, probeStarted);
+                _probeCache.Add(filename, stamp, mediaInfo, probeStarted, generation);
             }
 
             return mediaInfo;
         }
 
+        // The app put a new file at a path, deleted one or renamed one: forget what was probed at those paths. With
+        // "Change File Date" a new file gets the same last write time as the file it replaced, so the file stamp alone
+        // may not tell them apart.
+        public void Handle(EpisodeImportedEvent message)
+        {
+            ForgetProbe(message.EpisodeInfo?.Series?.Path, message.ImportedEpisode?.RelativePath);
+        }
+
+        public void Handle(EpisodeFileDeletedEvent message)
+        {
+            ForgetProbe(message.EpisodeFile?.Path);
+        }
+
+        public void Handle(EpisodeFileRenamedEvent message)
+        {
+            ForgetProbe(message.OriginalPath);
+            ForgetProbe(message.Series?.Path, message.EpisodeFile?.RelativePath);
+        }
+
+        private void ForgetProbe(string folder, string relativePath)
+        {
+            if (folder.IsNotNullOrWhiteSpace() && relativePath.IsNotNullOrWhiteSpace())
+            {
+                ForgetProbe(Path.Combine(folder, relativePath));
+            }
+        }
+
+        private void ForgetProbe(string path)
+        {
+            try
+            {
+                _probeCache.Invalidate(path);
+            }
+            catch (Exception ex)
+            {
+                _logger.Debug(ex, "Unable to drop cached media info for {0}", path);
+            }
+        }
+
         private bool TryGetFileStamp(string filename, out MediaInfoProbeCache.FileStamp stamp)
